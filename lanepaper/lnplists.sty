% ==============================================================================
% LNPLISTS.STY - List Typography Module
% ==============================================================================
% Extracted from lanepaper.sty for modular customization
% Implements sophisticated list typography with quantum-multiple spacing
% ==============================================================================

\ProvidesPackage{lnplists}[2026/08/12 v1.1 List Typography System]

% Dependencies
%% FIX: List markers use \scalebox, so their owner declares graphicx.
\RequirePackage{graphicx}         % Marker scaling with \scalebox
%% FIX: List hooks use etoolbox, so their owner declares it.
\RequirePackage{etoolbox}         % Environment hooks
\RequirePackage{enumitem}         % List spacing control

%% FIX (#85): lanepaper.sty loads lnpdimensions and lnpcolors before this
%% module and owns the order, so the \@ifpackageloaded fallbacks that made
%% standalone loading half-work are gone. This module uses \lnp@gridunit and
%% the \lnp@ colour palette and assumes both are already there.

% ==============================================================================
% LIST DESIGN SYSTEM
% ==============================================================================
% Implements sophisticated list typography following:
% - Butterick: Clean professional bullets and precise spacing
% - Hochuli: Consistent vertical rhythm
% - Brown: Systematic hierarchy through spacing
%
% HIERARCHY:
%   1. Standard lists (itemize) - professional gray bullets
%   2. Enumerated lists - oldstyle figures
%   3. Description lists - small caps labels
%   4. Specialized lists - context-specific formatting
% ==============================================================================

% LIST SPACING PARAMETERS
% All in multiples of the 13.2pt spacing quantum (baseline measures 16.32pt)
% Internal lengths now prefixed with \lnp@ to avoid namespace collisions
\newlength{\lnp@listhalfquantum}
\newlength{\lnp@listquarterquantum}
\newlength{\lnp@listquantum}
\newlength{\lnp@listhangindent}
\newlength{\lnp@listnestedindent}
\newlength{\lnp@listlabelsep}

% Initialise values
\setlength{\lnp@listhalfquantum}{0.5\lnp@gridunit}      % 6.6pt
\setlength{\lnp@listquarterquantum}{0.25\lnp@gridunit}   % 3.3pt
\setlength{\lnp@listquantum}{\lnp@gridunit}     % 13.2pt; the full-quantum list space (topsep)
\setlength{\lnp@listhangindent}{26.4pt}       % 2 quanta (optimized for Pagella)
\setlength{\lnp@listnestedindent}{13.2pt}     % 1 quantum for nested lists
\setlength{\lnp@listlabelsep}{0.7em}          % Space between bullet and text

% Compatibility aliases (deprecated; will be removed in v2.0)
\let\listhalfquantum\lnp@listhalfquantum
\let\listquarterquantum\lnp@listquarterquantum
\let\listquantum\lnp@listquantum
% Pre-rename names shipped in v2.1.0; deprecated, kept until the next major
\let\listhalfbaseline\lnp@listhalfquantum
\let\listquarterbaseline\lnp@listquarterquantum
\let\listbaselineskip\lnp@listquantum
\let\listhangindent\lnp@listhangindent
\let\listnestedindent\lnp@listnestedindent
\let\listlabelsep\lnp@listlabelsep

% ==============================================================================
% BULLET AND MARKER DEFINITIONS
% ==============================================================================
% Professional bullet hierarchy with refined typography

% Primary bullet - professional gray for subtlety
\newcommand{\bulletmark}{%
  \textcolor{lnp@subtlegray}{\raisebox{0.08ex}{\scalebox{0.9}{$\bullet$}}}%
}

% En-dash for academic lists
\newcommand{\dashmark}{%
  \textcolor{lnp@subtlegray}{\textendash}%
}

% Secondary bullet - smaller for nested lists
\newcommand{\refinedbullet}{%
  \textcolor{lnp@subtlegray}{\raisebox{0.1ex}{\scalebox{0.75}{$\bullet$}}}%
}

% Tertiary bullet - diamond for deep nesting
\newcommand{\diamondmark}{%
  \textcolor{lnp@subtlegray}{\raisebox{0.05ex}{\scalebox{0.7}{$\diamond$}}}%
}

% Additional markers for specialized lists
\newcommand{\squaremark}{%
  \textcolor{lnp@subtlegray}{\raisebox{0.1ex}{\scalebox{0.65}{$\blacksquare$}}}%
}

\newcommand{\trianglemark}{%
  \textcolor{lnp@subtlegray}{\raisebox{0ex}{\scalebox{0.8}{$\triangleright$}}}%
}

% Subtle bullet for compact lists
\newcommand{\subtlebullet}{%
  \textcolor{lightgray}{\raisebox{0.12ex}{\scalebox{0.65}{$\bullet$}}}%
}

% Refined en-dash with proper spacing
\newcommand{\refineddash}{%
  \textcolor{lnp@subtlegray}{\kern0.05em\textendash\kern0.05em}%
}

% ==============================================================================
% STANDARD LIST CONFIGURATIONS
% ==============================================================================

% ITEMIZE CONFIGURATION (Butterick's professional bullets)
\setlist[itemize,1]{
  label=\bulletmark,                            % Professional gray bullet
  align=left,
  leftmargin=\lnp@listhangindent,
  labelindent=0pt,
  labelsep=\lnp@listlabelsep,
  itemsep=\lnp@listquarterquantum,
  parsep=0pt,
  topsep=\lnp@listhalfquantum,
  partopsep=0pt,
  itemindent=0pt,
  listparindent=\parindent,
  before={\vspace{-\parskip}},
  after={\vspace{-\parskip}}
}

% Secondary level - refined bullet
\setlist[itemize,2]{
  label=\refineddash,                           % En-dash for variety
  leftmargin=\lnp@listnestedindent,
  labelindent=0pt,
  labelsep=\lnp@listlabelsep,
  itemsep=\lnp@listquarterquantum,
  parsep=0pt,
  topsep=\lnp@listquarterquantum,
  partopsep=0pt
}

% Tertiary level - diamond
\setlist[itemize,3]{
  label=\diamondmark,                           % Diamond for deep nesting
  leftmargin=\lnp@listnestedindent,
  labelindent=0pt,
  labelsep=\lnp@listlabelsep,
  itemsep=\lnp@listquarterquantum,
  parsep=0pt,
  topsep=\lnp@listquarterquantum,
  partopsep=0pt
}

% ENUMERATE CONFIGURATION (Hochuli's oldstyle numerals)
\setlist[enumerate,1]{
  label=\oldstylenums{\arabic*.},              % Oldstyle figures with period
  align=left,                                   % Left-align numbers
  widest=99,                                    % Reserve space for 2 digits
  leftmargin=\lnp@listhangindent,
  labelindent=0pt,
  labelsep=\lnp@listlabelsep,
  itemsep=\lnp@listquarterquantum,
  parsep=0pt,
  topsep=\lnp@listhalfquantum,
  partopsep=0pt,
  itemindent=0pt,
  listparindent=\parindent,
  before={\vspace{-\parskip}},
  after={\vspace{-\parskip}}
}

% Secondary enumeration with lowercase letters
\setlist[enumerate,2]{
  label=\alph*),                                % Lowercase letter with paren
  leftmargin=\lnp@listnestedindent,
  labelindent=0pt,
  labelsep=\lnp@listlabelsep,
  itemsep=\lnp@listquarterquantum,
  parsep=0pt,
  topsep=\lnp@listquarterquantum,
  partopsep=0pt
}

% Tertiary enumeration with roman numerals
\setlist[enumerate,3]{
  label=\roman*.,                               % Lowercase roman with period
  leftmargin=\lnp@listnestedindent,
  labelindent=0pt,
  labelsep=\lnp@listlabelsep,
  itemsep=\lnp@listquarterquantum,
  parsep=0pt,
  topsep=\lnp@listquarterquantum,
  partopsep=0pt
}

% DESCRIPTION LIST CONFIGURATION
% Professional hanging format for term definitions
\setlist[description]{
  font=\normalfont\scshape\color{lnp@paragraphcolor}, % Small caps terms
  labelindent=0pt,
  labelsep=\lnp@listlabelsep,
  leftmargin=\lnp@listhangindent,
  itemsep=\lnp@listquarterquantum,
  parsep=0pt,
  topsep=\lnp@listhalfquantum,
  partopsep=0pt,
  before={\vspace{-\parskip}},
  after={\vspace{-\parskip}}
}

% ==============================================================================
% SPECIALIZED LIST ENVIRONMENTS
% ==============================================================================
% Following Brown's systematic approach to different contexts


% Compact list for tight spacing (references, brief points)
\newlist{compactitem}{itemize}{3}
\setlist[compactitem,1]{
  label=\subtlebullet,
  leftmargin=\lnp@listhangindent,
  labelindent=0pt,
  labelsep=\lnp@listlabelsep,
  itemsep=0pt,                                  % No item spacing
  parsep=0pt,
  topsep=\lnp@listquarterquantum,                  % Minimal top/bottom
  partopsep=0pt,
  nosep                                         % Remove all spacing
}

% Display list for emphasis (key findings, important points)
\newlist{displayitem}{itemize}{3}
\setlist[displayitem,1]{
  label=\bulletmark,                            % Full black bullet
  leftmargin=\lnp@listhangindent,
  labelindent=0pt,
  labelsep=\lnp@listlabelsep,
  itemsep=\lnp@listhalfquantum,                    % Generous spacing
  parsep=0pt,
  topsep=\lnp@listquantum,                     % Full quantum above/below
  partopsep=0pt,
  font=\normalfont\bfseries\color{lnp@textblack}    % Bold items for emphasis
}

% Academic list with en-dash (following university style guides)
\newlist{academicitem}{itemize}{3}
\setlist[academicitem,1]{
  label=\llap{\refineddash\hspace{0.1em}},    % Refined en-dash
  leftmargin=\lnp@listhangindent,
  labelindent=0pt,
  labelsep=0.5em,
  itemsep=\lnp@listquarterquantum,
  parsep=0pt,
  topsep=\lnp@listhalfquantum,
  partopsep=0pt
}

% READABLE LIST (More spacing for enhanced readability)
\newlist{readableitem}{itemize}{3}
\setlist[readableitem,1]{
  label=\llap{\refinedbullet\hspace{0.15em}}, % Refined bullet
  leftmargin=\lnp@listhangindent,
  labelindent=0pt,
  labelsep=0.55em,
  itemsep=\lnp@listhalfquantum,                  % 0.5 units for readability
  parsep=0pt,
  topsep=0.75\lnp@gridunit plus 0.125\lnp@gridunit,     % 9.9pt +1.65pt
  partopsep=0pt,
  before={\vspace{-\parskip}\vspace{\lnp@listhalfquantum}},
  after={\vspace{-\parskip}\vspace{\lnp@listhalfquantum}}
}
%% FIX: Define nested readableitem labels so recursive readable lists compile.
\setlist[readableitem,2]{
  label=\llap{\refineddash\hspace{0.15em}},
  leftmargin=\lnp@listhangindent,
  labelindent=0pt,
  labelsep=0.55em,
  itemsep=\lnp@listquarterquantum,
  parsep=0pt,
  topsep=\lnp@listhalfquantum,
  partopsep=0pt
}
\setlist[readableitem,3]{
  label=\llap{\diamondmark\hspace{0.15em}},
  leftmargin=\lnp@listhangindent,
  labelindent=0pt,
  labelsep=0.55em,
  itemsep=\lnp@listquarterquantum,
  parsep=0pt,
  topsep=\lnp@listhalfquantum,
  partopsep=0pt
}

% Define the label command for academicitem
\renewcommand{\labelacademicitemi}{\dashmark}

% INLINE LISTS (Butterick's recommendation for brief items)
\newlist{inlineitem}{enumerate*}{1}
\setlist[inlineitem]{
  label=(\alph*),                               % Parenthetical letters
  itemjoin={{; }},                              % Semicolon separator
  afterlabel={\,},                              % Thin space after label
  itemsep=0pt,
  before={},
  after={}
}

% ==============================================================================
% CUSTOM BULLET COMMANDS
% ==============================================================================
% For manual control when needed

\newcommand{\itembullet}{\item[\bulletmark]}
\newcommand{\itemdash}{\item[\dashmark]}
\newcommand{\itemdiamond}{\item[\diamondmark]}
\newcommand{\itemsquare}{\item[\squaremark]}
\newcommand{\itemtriangle}{\item[\trianglemark]}

% ==============================================================================
% NESTED LIST SPACING REFINEMENT
% ==============================================================================
% Ensures consistent quantum rhythm
% Adjusted for more traditional spacing (0.5 quanta)

