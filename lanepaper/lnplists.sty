% ==============================================================================
% LNPLISTS.STY - List Typography Module
% ==============================================================================
% Extracted from lanepaper.sty for modular customization
% Implements sophisticated list typography with quantum-multiple spacing
% ==============================================================================

\ProvidesPackage{lnplists}[2026/08/12 v1.1 List Typography System]

% Dependencies
%% FIX: List markers use \scalebox, so their owner declares graphicx.
\RequirePackage{graphicx}         % Marker scaling with \scalebox
%% FIX: List hooks use etoolbox, so their owner declares it.
\RequirePackage{etoolbox}         % Environment hooks
\RequirePackage{enumitem}         % List spacing control

%% FIX (#85): lanepaper.sty loads lnpdimensions and lnpcolors before this
%% module and owns the order, so the \@ifpackageloaded fallbacks that made
%% standalone loading half-work are gone. This module uses \lnp@gridunit and
%% the \lnp@ colour palette and assumes both are already there.

% ==============================================================================
% LIST DESIGN SYSTEM
% ==============================================================================
% Implements sophisticated list typography following:
% - Butterick: Clean professional bullets and precise spacing
% - Hochuli: Consistent vertical rhythm
% - Brown: Systematic hierarchy through spacing
%
% HIERARCHY:
%   1. Standard lists (itemize) - professional gray bullets
%   2. Enumerated lists - oldstyle figures
%   3. Description lists - small caps labels
%   4. Inline lists - brief enumerations in running prose
% ==============================================================================

% LIST SPACING PARAMETERS
% All in multiples of the 13.2pt spacing quantum (baseline measures 16.32pt)
% Internal lengths now prefixed with \lnp@ to avoid namespace collisions
\newlength{\lnp@listhalfquantum}
\newlength{\lnp@listquarterquantum}
\newlength{\lnp@listhangindent}
\newlength{\lnp@listnestedindent}
\newlength{\lnp@listlabelsep}

% Initialise values
\setlength{\lnp@listhalfquantum}{0.5\lnp@gridunit}      % 6.6pt
\setlength{\lnp@listquarterquantum}{0.25\lnp@gridunit}   % 3.3pt
\setlength{\lnp@listhangindent}{26.4pt}       % 2 quanta (optimized for Pagella)
\setlength{\lnp@listnestedindent}{13.2pt}     % 1 quantum for nested lists
\setlength{\lnp@listlabelsep}{0.7em}          % Space between bullet and text

% ==============================================================================
% BULLET AND MARKER DEFINITIONS
% ==============================================================================
% Professional bullet hierarchy with refined typography

% Primary bullet - professional gray for subtlety
\newcommand{\lnp@bulletmark}{%
  \textcolor{lnp@subtlegray}{\raisebox{0.08ex}{\scalebox{0.9}{$\bullet$}}}%
}

% Smaller bullet for tertiary lists
\newcommand{\lnp@refinedbullet}{%
  \textcolor{lnp@subtlegray}{\raisebox{0.1ex}{\scalebox{0.75}{$\bullet$}}}%
}

% Refined en-dash with proper spacing
\newcommand{\lnp@refineddash}{%
  \textcolor{lnp@subtlegray}{\kern0.05em\textendash\kern0.05em}%
}

% ==============================================================================
% STANDARD LIST CONFIGURATIONS
% ==============================================================================

% ITEMIZE CONFIGURATION (Butterick's professional bullets)
\setlist[itemize,1]{
  label=\lnp@bulletmark,                        % Professional gray bullet
  align=left,
  leftmargin=\lnp@listhangindent,
  labelindent=0pt,
  labelsep=\lnp@listlabelsep,
  itemsep=\lnp@listquarterquantum,
  parsep=0pt,
  topsep=\lnp@listhalfquantum,
  partopsep=0pt,
  itemindent=0pt,
  listparindent=\parindent,
  before={\vspace{-\parskip}},
  after={\vspace{-\parskip}}
}

% Secondary level - refined bullet
\setlist[itemize,2]{
  label=\lnp@refineddash,                       % En-dash for hierarchy
  leftmargin=\lnp@listnestedindent,
  labelindent=0pt,
  labelsep=\lnp@listlabelsep,
  itemsep=\lnp@listquarterquantum,
  parsep=0pt,
  topsep=\lnp@listquarterquantum,
  partopsep=0pt
}

% Tertiary level - smaller bullet
\setlist[itemize,3]{
  label=\lnp@refinedbullet,
  leftmargin=\lnp@listnestedindent,
  labelindent=0pt,
  labelsep=\lnp@listlabelsep,
  itemsep=\lnp@listquarterquantum,
  parsep=0pt,
  topsep=\lnp@listquarterquantum,
  partopsep=0pt
}

% ENUMERATE CONFIGURATION (Hochuli's oldstyle numerals)
\setlist[enumerate,1]{
  label=\oldstylenums{\arabic*.},              % Oldstyle figures with period
  align=left,                                   % Left-align numbers
  widest=99,                                    % Reserve space for 2 digits
  leftmargin=\lnp@listhangindent,
  labelindent=0pt,
  labelsep=\lnp@listlabelsep,
  itemsep=\lnp@listquarterquantum,
  parsep=0pt,
  topsep=\lnp@listhalfquantum,
  partopsep=0pt,
  itemindent=0pt,
  listparindent=\parindent,
  before={\vspace{-\parskip}},
  after={\vspace{-\parskip}}
}

% Secondary enumeration with lowercase letters
\setlist[enumerate,2]{
  label=\alph*),                                % Lowercase letter with paren
  leftmargin=\lnp@listnestedindent,
  labelindent=0pt,
  labelsep=\lnp@listlabelsep,
  itemsep=\lnp@listquarterquantum,
  parsep=0pt,
  topsep=\lnp@listquarterquantum,
  partopsep=0pt
}

% Tertiary enumeration with roman numerals
\setlist[enumerate,3]{
  label=\roman*.,                               % Lowercase roman with period
  leftmargin=\lnp@listnestedindent,
  labelindent=0pt,
  labelsep=\lnp@listlabelsep,
  itemsep=\lnp@listquarterquantum,
  parsep=0pt,
  topsep=\lnp@listquarterquantum,
  partopsep=0pt
}

% DESCRIPTION LIST CONFIGURATION
% Professional hanging format for term definitions
\setlist[description]{
  font=\normalfont\scshape\color{lnp@paragraphcolor}, % Small caps terms
  labelindent=0pt,
  labelsep=\lnp@listlabelsep,
  leftmargin=\lnp@listhangindent,
  itemsep=\lnp@listquarterquantum,
  parsep=0pt,
  topsep=\lnp@listhalfquantum,
  partopsep=0pt,
  before={\vspace{-\parskip}},
  after={\vspace{-\parskip}}
}

% INLINE LISTS (Butterick's recommendation for brief items)
\newlist{inlineitem}{enumerate*}{1}
\setlist[inlineitem]{
  label=(\alph*),                               % Parenthetical letters
  itemjoin={{; }},                              % Semicolon separator
  afterlabel={\,},                              % Thin space after label
  itemsep=0pt,
  before={},
  after={}
}

% CONSOLIDATED ENVIRONMENT HOOKS
% ==============================================================================
% All list environment hooks are centralized here to avoid conflicts
% This prevents "missing \item" errors when using \paragraph commands

% Ensure list environments work properly with other environments
\AtBeginEnvironment{itemize}{\parindent=0pt\@afterindentfalse}
\AtBeginEnvironment{enumerate}{\parindent=0pt\@afterindentfalse}
\AtBeginEnvironment{description}{\parindent=0pt\@afterindentfalse}

% First paragraph after lists is flush left
\AtEndEnvironment{itemize}{\@afterindentfalse}
\AtEndEnvironment{enumerate}{\@afterindentfalse}
\AtEndEnvironment{description}{\@afterindentfalse}
