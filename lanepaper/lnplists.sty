% ==============================================================================
% LIST SPACING STYLES
% ==============================================================================
% Commands to switch between different list spacing approaches

\newcommand{\tightlists}{%
  % Minimal spacing for dense information
  \setlist[itemize,1]{itemsep=0pt, topsep=\lnp@listquarterquantum}
  \setlist[enumerate,1]{itemsep=0pt, topsep=\lnp@listquarterquantum}
}

\newcommand{\normallists}{%
  % Default spacing (current settings)
  \setlist[itemize,1]{itemsep=\lnp@listquarterquantum, topsep=\lnp@listhalfquantum}
  \setlist[enumerate,1]{itemsep=\lnp@listquarterquantum, topsep=\lnp@listhalfquantum}
}

\newcommand{\spaciouslists}{%
  % Generous spacing for readability
  \setlist[itemize,1]{itemsep=\lnp@listhalfquantum, topsep=\lnp@listquantum}
  \setlist[enumerate,1]{itemsep=\lnp@listhalfquantum, topsep=\lnp@listquantum}
}

% ==============================================================================
% LIST CUSTOMIZATION INTERFACE
% ==============================================================================
% User-friendly commands for common list modifications

% Change all bullets to en-dashes
\newcommand{\dashbullets}{%
  \setlist[itemize,1]{label=\dashmark}
}

% Change all bullets to triangles
\newcommand{\trianglebullets}{%
  \setlist[itemize,1]{label=\trianglemark}
}

% Restore default bullets
\newcommand{\defaultbullets}{%
  \setlist[itemize,1]{label=\bulletmark}
}

% ==============================================================================
% LEGACY SUPPORT
% ==============================================================================
% Maintain backward compatibility with simple spacing

% CONSOLIDATED ENVIRONMENT HOOKS
% ==============================================================================
% All list environment hooks are centralized here to avoid conflicts
% This prevents "missing \item" errors when using \paragraph commands

% Ensure list environments work properly with other environments
\AtBeginEnvironment{itemize}{\parindent=0pt\@afterindentfalse}
\AtBeginEnvironment{enumerate}{\parindent=0pt\@afterindentfalse}
\AtBeginEnvironment{description}{\parindent=0pt\@afterindentfalse}

% First paragraph after lists is flush left
\AtEndEnvironment{itemize}{\@afterindentfalse}
\AtEndEnvironment{enumerate}{\@afterindentfalse}
\AtEndEnvironment{description}{\@afterindentfalse}
\AtEndEnvironment{compactitem}{\@afterindentfalse}
\AtEndEnvironment{displayitem}{\@afterindentfalse}
\AtEndEnvironment{academicitem}{\@afterindentfalse}
\AtEndEnvironment{readableitem}{\@afterindentfalse}

% ==============================================================================
% ROBUSTNESS (#55)
% ==============================================================================
% Every public macro defined above is made robust for moving arguments
% (section titles, captions, marks, the .aux round-trip) via etoolbox
% \robustify, which applies e-TeX \protected. Definitions stay \newcommand
% so a name collision with another package still errors at load time.
% \ifdefmacro skips names that resolve to registers in this load order.
\ifdefmacro{\bulletmark}{\robustify{\bulletmark}}{}
\ifdefmacro{\dashmark}{\robustify{\dashmark}}{}
\ifdefmacro{\refinedbullet}{\robustify{\refinedbullet}}{}
\ifdefmacro{\diamondmark}{\robustify{\diamondmark}}{}
\ifdefmacro{\squaremark}{\robustify{\squaremark}}{}
\ifdefmacro{\trianglemark}{\robustify{\trianglemark}}{}
\ifdefmacro{\subtlebullet}{\robustify{\subtlebullet}}{}
\ifdefmacro{\refineddash}{\robustify{\refineddash}}{}
\ifdefmacro{\labelacademicitemi}{\robustify{\labelacademicitemi}}{}
\ifdefmacro{\itembullet}{\robustify{\itembullet}}{}
\ifdefmacro{\itemdash}{\robustify{\itemdash}}{}
\ifdefmacro{\itemdiamond}{\robustify{\itemdiamond}}{}
\ifdefmacro{\itemsquare}{\robustify{\itemsquare}}{}
\ifdefmacro{\itemtriangle}{\robustify{\itemtriangle}}{}
\ifdefmacro{\tightlists}{\robustify{\tightlists}}{}
\ifdefmacro{\normallists}{\robustify{\normallists}}{}
\ifdefmacro{\spaciouslists}{\robustify{\spaciouslists}}{}
\ifdefmacro{\dashbullets}{\robustify{\dashbullets}}{}
\ifdefmacro{\trianglebullets}{\robustify{\trianglebullets}}{}
\ifdefmacro{\defaultbullets}{\robustify{\defaultbullets}}{}
