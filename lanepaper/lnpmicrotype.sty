% ==============================================================================
% LNPMICROTYPE.STY - Microtype Configuration
% ==============================================================================

\ProvidesPackage{lnpmicrotype}[2026/08/31 v3.0.0 Microtype Configuration]

\@ifpackageloaded{microtype}{%
  \PackageInfo{lnpmicrotype}{microtype already loaded - enabling retained features}%
}{%
  \RequirePackage[protrusion=true,expansion=true,tracking=true]{microtype}%
}

%% FIX (#29): Use microtype's shipped qpl -> ppl alias, mt-ppl.cfg protrusion,
%% and default expansion rather than maintaining local font tables.
\microtypesetup{protrusion=true,expansion=true,tracking=true}

%% FIX (#29): Follow the Microtype manual's small-caps tracking pattern and
%% disable f ligatures in spaced text. +50 is 5%, the restrained end of
%% Butterick's 5--12% recommendation for all caps and small caps:
%% https://practicaltypography.com/letterspacing.html
\SetTracking[
  no ligatures = {f}
]{
  encoding = {T1},
  family = {qpl},
  shape = {sc}
}{50}

\endinput
