% ==============================================================================
% LNPGRIDOVERLAY.STY - Visual Baseline-Grid Overlay for Typography Testing
% ==============================================================================
%
% Draws the document's real baseline grid (lines every \baselineskip, 16.32pt
% in the default setup) so line positions can be verified visually. Designed
% for development and testing only.
%
% The overlay draws only the baseline grid. The 13.2pt spacing quantum
% (\gridunit) is a unit spacing values are stated in, not a set of positions
% text occupies, so it has no lines here (ADR-0005).
%
% USAGE:
%   \usepackage{lnpgridoverlay}  % Load package
%   \showgrid                    % Activate grid overlay
%   \hidegrid                    % Deactivate grid overlay
%   \showgrid[red]               % Custom color grid
%
% ------------------------------------------------------------------------------

\ProvidesPackage{lnpgridoverlay}[2026/08/12 v1.1 Visual Grid Overlay System]
\RequirePackage{etoolbox} % for \robustify (#55)

% Required packages
\RequirePackage{tikz}
\RequirePackage{eso-pic}
\RequirePackage{xcolor}

% Grid visibility toggle
\newif\ifshowgrid
\showgridfalse

% Command to show grid overlay
\newcommand{\showgrid}[1][gray]{%
  \showgridtrue
  \definecolor{gridcolor}{named}{#1}%
  \AddToShipoutPictureBG{\gridoverlay}%
}

% Command to hide grid overlay
\newcommand{\hidegrid}{%
  \showgridfalse
  \ClearShipoutPictureBG
}

% The actual grid overlay
\newcommand{\gridoverlay}{%
  \ifshowgrid
  \AtPageLowerLeft{%
    \tikz[overlay,remember picture]{
      % Baseline grid: lines every \baselineskip, where body lines land
      \pgfmathsetmacro{\gridstep}{\baselineskip/1pt}
      \foreach \y in {0,\gridstep,...,850} {
        \draw[gridcolor!30,line width=0.05pt] (0,\y pt) -- (\paperwidth,\y pt);
      }

      % Margin indicators
      \draw[black!20,line width=0.5pt] (1.25in,0) -- (1.25in,\paperheight);
      \draw[black!20,line width=0.5pt] (\paperwidth-1.25in,0) -- (\paperwidth-1.25in,\paperheight);

      % Page info
      \node[black!40,font=\tiny,anchor=north east] at (\paperwidth-5pt,\paperheight-5pt)
        {Baseline: \the\baselineskip\ | Page \thepage};
    }
  }
  \fi
}


% ==============================================================================
% ROBUSTNESS (#55)
% ==============================================================================
% Every public macro defined above is made robust for moving arguments
% (section titles, captions, marks, the .aux round-trip) via etoolbox
% \robustify, which applies e-TeX \protected. Definitions stay \newcommand
% so a name collision with another package still errors at load time.
% \ifdefmacro skips names that resolve to registers in this load order.
\ifdefmacro{\showgrid}{\robustify{\showgrid}}{}
\ifdefmacro{\hidegrid}{\robustify{\hidegrid}}{}
\ifdefmacro{\gridoverlay}{\robustify{\gridoverlay}}{}

\endinput
