%   {13.2pt}%                     % Space below (1 quantum)
%   {\itshape}%                   % Body font
%   {0pt}%                        % Indent amount
%   {\bfseries}%                  % Theorem head font
%   {.}%                          % Punctuation after theorem head
%   {.5em}%                       % Space after theorem head
%   {}%                           % Theorem head spec
% \theoremstyle{pagellathm}

% DISPLAY MATH CENTERING
% Ensure equations respect the grid
\g@addto@macro\normalsize{%
  \setlength{\abovedisplayskip}{1.5\lnp@gridunit plus 0.25\lnp@gridunit minus 0.25\lnp@gridunit}%
  \setlength{\belowdisplayskip}{1.5\lnp@gridunit plus 0.25\lnp@gridunit minus 0.25\lnp@gridunit}%
  \setlength{\abovedisplayshortskip}{1\lnp@gridunit plus 0.25\lnp@gridunit minus 0.25\lnp@gridunit}%
