% APPENDIX SYSTEM INITIALIZATION
% Core package and counter setup
%% Issue #48 (ADR-0003 rule 2): appendix is detected, not loaded. The
%% detection below already existed; loading the package here made it
%% always true. \startappendices falls back to plain \appendix when the
%% document has not loaded it.


% Internal counter for tracking appendices in current document
\newcounter{appendixcount}
\setcounter{appendixcount}{0}

% Boolean to track single vs multiple appendices
\newif\ifmultipleappendices
\multipleappendicesfalse

% Initialize appendix count variable
\def\lnp@totalappendices{0}

% Set up appendix count reading at begin document
\AtBeginDocument{%
  % Read appendix count from aux file if available
  \@ifundefined{lnp@totalappendices}{\def\lnp@totalappendices{0}}{}%
}

% Robust appendix system - Overleaf compatible
% Uses simple commands that work in all TeX versions

% Create internal flags without @ symbols
\newif\iflnp@appendixloaded
\newif\iflnp@sectionsaved

% Check for appendix package at load time
%% Deferred: the document may load appendix after this package, and the
%% flag is not read until \startappendices runs in the document body.
\AtBeginDocument{%
  \@ifpackageloaded{appendix}{\lnp@appendixloadedtrue}{\lnp@appendixloadedfalse}%
}

% Store original section command at package load time
\let\lnp@origsection\section

%% FIX: Preserve starred and optional \section forms inside appendix wrappers.
\newcommand{\lnp@appendixsection}{%
  \@ifstar{\lnp@appendixsectionstar}{\lnp@appendixsectionnostar}%
}
\newcommand{\lnp@appendixsectionstar}[1]{%
  \lnp@origsection*{#1}%
}
\newcommand{\lnp@appendixsectionnostar}{%
  \@ifnextchar[{%
    \lnp@appendixsectionwithopt
  }{%
    \lnp@appendixsectionplain
  }%
}
\def\lnp@appendixsectionwithopt[#1]#2{%
  \stepcounter{appendixcount}%
  \lnp@origsection[#1]{#2}%
}
\newcommand{\lnp@appendixsectionplain}[1]{%
  \stepcounter{appendixcount}%
  \lnp@origsection{#1}%
}

% Main appendix commands
\newcommand{\startappendices}{%
  \clearpage%
  % Check if appendices package is loaded
  \iflnp@appendixloaded
    % Use appendices environment if available
    \begin{appendices}%
    \addappheadtotoc%
  \else
    % Fallback to basic appendix command
    \appendix%
    %% \phantomsection is hyperref's. #48 stopped loading hyperref, so a
    %% document that does not load it reaches this branch with the command
    %% undefined -- a fatal error, not merely less styling. Degrade to a
    %% no-op, which is what hyperref's own documentation recommends.
    \providecommand{\phantomsection}{}%
    \phantomsection%
    \addcontentsline{toc}{section}{Appendices}%
  \fi
  % Reset counter for tracking
  \setcounter{appendixcount}{0}%
  % Mark that we've saved the section command
  \lnp@sectionsavedtrue
  % Redefine section to count appendices
  \renewcommand{\section}{\lnp@appendixsection}%
}

% Helper to write appendix count
% Fix: Avoid @ symbols completely by using standard LaTeX commands
\newcommand{\lnp@writecount}{%
  \addtocontents{aux}{\string\gdef\string\lnp@totalappendices{\theappendixcount}}%
}

\newcommand{\finishappendices}{%
  % Write count for next run
  \lnp@writecount
  % Close appendices environment if used
  \iflnp@appendixloaded
    \end{appendices}%
  \fi
  % Restore original section command
  \iflnp@sectionsaved
    \let\section\lnp@origsection
    %% FIX: Clear saved-section state after restoring \section.
    \lnp@sectionsavedfalse
  \fi
}

% Legacy environment names for backward compatibility
\newenvironment{documentAppendices}{%
  \startappendices%
}{%
  \finishappendices%
}

