\setlength{\aboverulesep}{0pt}          % Remove space above booktabs rules
\setlength{\belowrulesep}{0pt}          % Remove space below booktabs rules
\setlength{\extrarowheight}{2.2pt}       % Extra row height; standard row measures 21.8pt (\arraystretch 1.2 × 16.32pt baseline + 2.2pt), not 13.2pt
%% Issue #48: longtable typography, applied only if the document loaded it.
