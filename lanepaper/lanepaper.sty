% ==============================================================================
% LANEPAPER.STY - Academic Typography Package
% ==============================================================================
%
% A comprehensive LaTeX style package for academic typography excellence,
% implementing principles from three foundational typographic works:
%
% PRIMARY REFERENCES:
%   [1] Butterick, M. (2019). Practical Typography, 2nd ed.
%       https://practicaltypography.com
%   [2] Brown, T. (2018). Flexible Typographic Systems. A Book Apart.
%   [3] Hochuli, J. (1987/2008). Detail in Typography. Hyphen Press.
%
% DESIGN PHILOSOPHY:
%   - Reader-focused optimization (Butterick)
%   - Mathematical harmony via modular scale (Brown) 
%   - Micro-typographic excellence (Hochuli)
%   - Chicago Manual of Style compliance
%   - Accessibility standards (WCAG 2.1 AA)
%
% VERSION HISTORY:
%   v1.7 (2026-05-28): Hardened option contracts and microtype module ownership
%   v1.6 (2025-07-09): Added package options (grid, minimal, natbib, nocolor, draft)
%   v1.5 (2025-07-02): Modularization - extracted colors, dimensions, fonts modules
%   v1.4.1 (2025-07-02): Code cleanup - removed unused commands, fixed duplicate loads
%   v1.4 (2025-07-02): Cross-reference typography optimization with cleveref
%   v1.3 (2025-07-02): Mathematical typography optimization for Pagella
%   v1.2 (2025-06-27): Added Chicago-compliant appendix system
%   v1.1 (2025-06-26): Enhanced bold small caps with weight compensation
%   v1.0 (2025-06-25): Initial release with typography synthesis
%
% TECHNICAL REQUIREMENTS:
%   - LaTeX 2e (2018/01/01 or later)
%   - pdfTeX only (pdfLaTeX); see the engine guard below
%   - Modern TeX distribution (TeX Live 2023+, MiKTeX current)
%
% DEPENDENCIES:
%   Core: fontenc, fbb, zi4, newtxmath, mathalfa, microtype
%   Layout: titlesec, enumitem, caption, geometry  
%   Advanced: appendix, cleveref, hyperref
%
% USAGE:
%   \usepackage{lanepaper}                   % Full features
%   \usepackage[grid]{lanepaper}             % Show grid overlay
%   \usepackage[minimal]{lanepaper}          % Minimal features only
%   \usepackage[natbib]{lanepaper}           % Use native natbib support
%   \usepackage[nocolor]{lanepaper}          % Use black/grayscale colors
%   \usepackage[draft]{lanepaper}            % Draft mode with visible boxes
%   or
%   \input{demo/preamble.tex}  % Recommended with bibliography
%
% PACKAGE OPTIONS:
%   grid/nogrid - Enable/disable the grid overlay (default: nogrid)
%   minimal     - Load only essential features (dimensions, compilation fixes)
%   natbib      - Load native natbib support instead of biblatex
%   nocolor     - Map semantic colors to black/grayscale values
%   draft       - Draft mode with visible overfull boxes and link borders
%   nobiblatex  - Disable automatic biblatex loading (if you load it manually)
%   subsectionbarriers/nosubsectionbarriers - Toggle automatic subsection barriers
%
% DOCUMENTATION:
%   - docs/package/README.md (complete API reference)
%   - docs/package/STYLE_GUIDE.md (typography standards)
%   - Inline comments throughout this file
%
% ==============================================================================

\NeedsTeXFormat{LaTeX2e}[2018/01/01]
\ProvidesPackage{lanepaper}[2026/08/12 v2.0 Academic Typography - Package Options]

% ==============================================================================
% ENGINE GUARD
% ==============================================================================
% This package is pdfLaTeX-only. The font stack is 8-bit and pdfTeX-shaped --
% T1 fontenc, utf8 inputenc, newpxmath, mathalfa, zi4 and Type1 tgpagella --
% with no fontspec path, and microtype font expansion is unsupported on XeTeX.
% Without this guard a XeLaTeX or LuaLaTeX user gets a cascade of font errors
% instead of one message saying what is wrong.
\RequirePackage{iftex}
\ifpdftex\else
  \PackageError{lanepaper}{%
    pdfTeX is required, but this document is being compiled with another engine%
  }{%
    lanepaper is pdfLaTeX-only.\MessageBreak
    Its font stack (T1 fontenc, utf8 inputenc, newpxmath, mathalfa, zi4,\MessageBreak
    Type1 tgpagella) has no fontspec path, and microtype font expansion\MessageBreak
    is unsupported on XeTeX.\MessageBreak
    Compile with pdflatex.%
  }%
  %% Stop the run. Without this the error is recoverable, so a nonstopmode
  %% build continues into exactly the font cascade this guard exists to
  %% prevent -- microtype alone adds two more errors on XeTeX.
  \batchmode\@@end
\fi

% ==============================================================================
% PACKAGE OPTIONS
% ==============================================================================
%
% The lanepaper package supports the following options:
%
% grid/nogrid (default: nogrid)
%   - grid: Display the grid overlay (true-baseline and quantum lines) for typography debugging
%   - nogrid: Hide the grid overlay (normal production mode)
%   - Usage: \usepackage[grid]{lanepaper}
%   - Effect: Loads gridoverlay module and automatically calls \showgrid
%
% minimal (default: off)  
%   - Load only essential features: dimensions and compilation fixes
%   - Skips: fonts, headings, lists, and most typography enhancements
%   - Usage: \usepackage[minimal]{lanepaper}
%   - Use case: Compatibility mode or when custom typography is needed
%
% natbib (default: off)
%   - Load native natbib author-year citation support
%   - Usage: \usepackage[natbib]{lanepaper}
%   - Note: Provides natbib commands, not biblatex command emulation
%
% nocolor (default: off)
%   - Map semantic template colors to black/grayscale values
%   - Affects: headings, links, bullets, and all colored elements
%   - Usage: \usepackage[nocolor]{lanepaper}
%   - Use case: Accessibility, printing, or journal requirements
%
% draft (default: off)
%   - Enable draft mode with visible overfull boxes
%   - Shows colored borders around hyperlinks instead of colored text
%   - Passes draft option to microtype package
%   - Usage: \usepackage[draft]{lanepaper}
%   - Use case: Debugging layout issues and overfull boxes
%
% nobiblatex (default: off)
%   - Disable automatic biblatex loading
%   - Use when you need to load biblatex manually with custom options
%   - Usage: \usepackage[nobiblatex]{lanepaper}
%   - Use case: Custom bibliography configuration or using natbib
%
% subsectionbarriers/nosubsectionbarriers (default: subsectionbarriers)
%   - Enable or disable automatic \FloatBarrier insertion before subsections
%   - Usage: \usepackage[nosubsectionbarriers]{lanepaper}
%   - Use case: Documents that need freer float movement across subsections
%
% Multiple options can be combined:
%   \usepackage[draft,grid]{lanepaper}
%   \usepackage[minimal,nocolor]{lanepaper}
%
% ------------------------------------------------------------------------------

% Define boolean flags for package options
\newif\iflnp@grid
\newif\iflnp@minimal
\newif\iflnp@natbib
\newif\iflnp@nocolor
\newif\iflnp@draft
\newif\iflnp@nobiblatex
\newif\iflnp@subsectionbarriers
\lnp@subsectionbarrierstrue
%% FIX: opt-in flag for math redefinitions (they change mathematical meaning,
%% not just appearance, so they must not be unconditional).
\newif\iflnp@mathredefs

% Declare package options
\DeclareOption{grid}{\lnp@gridtrue}
\DeclareOption{nogrid}{\lnp@gridfalse}
\DeclareOption{minimal}{\lnp@minimaltrue}
%% Deprecated by #48: this package no longer loads a bibliography package,
%% so there is nothing for [natbib] or [nobiblatex] to switch. Both are
%% still accepted so existing documents do not fail on an unknown option.
\DeclareOption{natbib}{\lnp@natbibtrue}
\DeclareOption{nocolor}{\lnp@nocolortrue}
%% FIX: Let lnpmicrotype apply draft mode after package options are processed.
\DeclareOption{draft}{\lnp@drafttrue}
\DeclareOption{nobiblatex}{\lnp@nobiblatextrue}
%% FIX: Expose subsection float-barrier behavior as a documented package option.
\DeclareOption{subsectionbarriers}{\lnp@subsectionbarrierstrue}
\DeclareOption{nosubsectionbarriers}{\lnp@subsectionbarriersfalse}
%% FIX: [mathredefs] opts into the \le/\ge/\epsilon/\phi/\vec redefinitions;
%% default is standard LaTeX semantics.
\DeclareOption{mathredefs}{\lnp@mathredefstrue}

% Process options
\ProcessOptions\relax

%% Deprecation notice for the two bibliography options (#48).
\iflnp@natbib
  \PackageWarning{lanepaper}{The [natbib] option is deprecated and does
    nothing: this package no longer loads a bibliography package. Load natbib
    in your document instead. See CONVENTIONS.md}%
\fi
\iflnp@nobiblatex
  \PackageWarning{lanepaper}{The [nobiblatex] option is deprecated and does
    nothing: this package no longer loads biblatex, so there is nothing to
    disable. See CONVENTIONS.md}%
\fi

%% FIX: Load inputenc only when needed and never after a user-loaded biblatex
%% contract to avoid load-order warnings.
\newcommand{\lnp@maybe@load@inputenc}{%
  \@ifpackageloaded{inputenc}{}{%
    \@ifpackageloaded{biblatex}{}{%
      \RequirePackage[utf8]{inputenc}%
    }%
  }%
}

%% Issue #48 (ADR-0003 rule 2): the bibliography belongs to the document.
%% This package loaded biblatex with its own option set, which fixed the
%% backend, style and sorting for every document using it and forced anyone
%% wanting different options to pass [nobiblatex] and load it themselves.
%%
%% It configures nothing about biblatex -- there is no \DeclareFieldFormat,
%% \ExecuteBibliographyOptions or bibmacro anywhere in lanepaper/ -- so rule 2
%% leaves only the removal. Load biblatex (or natbib) in the document.
%% demo/preamble.tex shows the option set this package used to apply.
\@ifpackageloaded{biblatex}{%
  \PackageInfo{lanepaper}{biblatex detected}%
}{%
  \@ifpackageloaded{natbib}{%
    \PackageInfo{lanepaper}{natbib detected}%
  }{%
    \PackageInfo{lanepaper}{No bibliography package loaded; the document owns
      its bibliography since issue #48}%
  }%
}

% ==============================================================================
% I. FONT SYSTEM CONFIGURATION
% ==============================================================================
% 
% This section configures the three-font typography system:
% 1. Text: TeX Gyre Pagella (Palatino-based) with full OpenType features
% 2. Mathematics: newpxmath perfectly harmonized with Pagella  
% 3. Monospace: Inconsolata (zi4) scaled for Pagella integration
%
% PAGELLA CHARACTERISTICS:
%   - Larger x-height than Bembo (requires adjusted leading)
%   - Wider character width (affects line length calculations)
%   - Stronger stroke contrast (benefits from different microtype settings)
%   - Superior small caps design (less tracking needed)
%
% REFERENCES:
%   - GUST e-foundry (2009). TeX Gyre Pagella. GUST.
%   - Sharpe, M. (2021). newpx: Palatino-based math fonts. CTAN.
%   - Zapf, H. (1950). Original Palatino design principles.
% 
% ------------------------------------------------------------------------------

% Font configuration has been moved to lnpfonts.sty
% This includes: tgpagella, zi4 (Inconsolata), newpxmath, mathalfa
\RequirePackage{etoolbox} % For \AtBeginEnvironment and hooks

% ==============================================================================
% MODULAR COMPONENT LOADING
% ==============================================================================
% Load modular components if not already loaded
% This allows users to override modules before loading lanepaper

% Always load core modules
%% FIX: Load local modules by package name to match their \ProvidesPackage names.
\@ifpackageloaded{lnpcompilationfixes}{}{\RequirePackage{lnpcompilationfixes}}
\@ifpackageloaded{lnpdimensions}{}{\RequirePackage{lnpdimensions}}
%% FIX: Always load semantic colors so nocolor and minimal mode share definitions.
\@ifpackageloaded{lnpcolors}{}{\RequirePackage{lnpcolors}}

% Load essential packages for minimal mode
\iflnp@minimal
  % Minimal mode still needs these essential packages
  \lnp@maybe@load@inputenc
  \RequirePackage{amsmath}
  \RequirePackage{textcomp}
  \RequirePackage{xcolor}
\else
  % Full mode loads all modules
  \@ifpackageloaded{lnpfonts}{}{\RequirePackage{lnpfonts}}
  \@ifpackageloaded{lnpheadings}{}{\RequirePackage{lnpheadings}}
  \@ifpackageloaded{lnplists}{}{\RequirePackage{lnplists}}
\fi

% Load grid overlay if requested
\iflnp@grid
  \@ifpackageloaded{lnpgridoverlay}{}{\RequirePackage{lnpgridoverlay}}
  \showgrid
\fi


