% RETAINED FRONT-MATTER SMALL CAPS (private)
% v3 (issue #84) removed the generic public small-caps API (\refinedsc,
% \elegantsc, \meta, \regsc, ...). Only the title-page small caps consumed by
% the retained front matter survives; it is now private and visually unchanged.
%% FIX(#39): explicit \fontsize{11pt} matches no named-size sc list, so {50} was
%% effective; \textls[50] reproduces the original (like \abstractopening above).
\newcommand{\lnp@titlesc}[1]{%
  {\fontsize{11pt}{13pt}\selectfont\scshape\textls[50]{#1}}%
}

