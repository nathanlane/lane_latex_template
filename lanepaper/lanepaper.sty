  \else
    \textit{#1}%      % Roman -> Italic
  \fi
}

% Smart bold that adds italic in bold context
\newcommand{\smartbold}[1]{%
  \ifx\f@series\bfdefault
    \textbf{\textit{#1}}%  % Bold -> Bold italic
  \else
    \textbf{#1}%           % Regular -> Bold
  \fi
}

