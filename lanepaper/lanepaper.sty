% XI. MATHEMATICAL TYPOGRAPHY OPTIMIZATION
% ==============================================================================
%
% Implements sophisticated mathematical typography following Knuth's principles
% with specific optimizations for TeX Gyre Pagella and the 13.2pt spacing quantum.
%
% DESIGN PHILOSOPHY:
%   - Knuth: "Mathematics must harmonize with surrounding text"
%   - Butterick: "Mathematical notation should be readable, not just correct"
%   - Hochuli: "Micro-adjustments create macro-improvements"
%   - Brown: Systematic size relationships via modular scale
%
% PAGELLA-SPECIFIC CONSIDERATIONS:
%   - Larger x-height (464/1000em) requires adjusted inline sizing
%   - Wider characters (~110% of CM) need more operator spacing
%   - Higher stroke contrast benefits from optical corrections
%   - 10° italic angle (vs CM's 14°) affects script positioning
%
% REFERENCES:
%   - Knuth, D. (1986). The TeXbook. Addison-Wesley.
%   - Downes, M. (2002). Technical Notes on the amsmath Package. AMS.
%   - Sharpe, M. (2024). The newpx package documentation. CTAN.
%
% ------------------------------------------------------------------------------

% DISPLAY EQUATION SPACING
% Values in spacing quanta; flexibility lets TeX compose pages. Rationale
% (ADR-0005): a multi-line display reads as one object, so compact internal
% leading binds its rows while \abovedisplayskip separates the block from
% prose; maths rows carry their own vertical bulk and \lineskip guards
% collisions. Display rows land on no grid; nothing here aligns to one.
\abovedisplayskip=1.5\lnp@gridunit plus 0.25\lnp@gridunit minus 0.25\lnp@gridunit    % 19.8pt ±3.3pt
\belowdisplayskip=1.5\lnp@gridunit plus 0.25\lnp@gridunit minus 0.25\lnp@gridunit    % 19.8pt ±3.3pt
\abovedisplayshortskip=1\lnp@gridunit plus 0.25\lnp@gridunit minus 0.25\lnp@gridunit  % 13.2pt ±3.3pt
\belowdisplayshortskip=1\lnp@gridunit plus 0.25\lnp@gridunit minus 0.25\lnp@gridunit  % 13.2pt ±3.3pt

% Multi-line equation spacing
%% FIX: the unconditional \AtBeginDocument \addtolength below adds another
%% 0.25\lnp@gridunit, so \jot ships as 9.9pt (measured), not 6.6pt. Value kept;
%% the claim is corrected here and there.
\jot=0.5\lnp@gridunit  % 0.5 quanta (6.6pt) before the begindocument-hook addition (ships as 9.9pt)

% Optimized script sizes for Pagella readability
%% FIX: the document body runs at 10.95pt (the class's 11pt option), so the
%% previous {11} key never fired and script sizes fell back to the class
%% defaults (measured scriptscript 6.1pt, not the declared 6pt). Keyed to
%% 10.95 so the declaration actually applies.
\DeclareMathSizes{10.95}{10.95}{8}{6}  % text, script, scriptscript, tiny

%% FIX: applies to EVERY multi-line display (the addition is unconditional),
%% despite the earlier "numbered equations" claim. In-force \jot = 9.9pt.
\AddToHook{begindocument}{%
  \addtolength{\jot}{0.25\lnp@gridunit}  % +0.25 quanta: total \jot = 9.9pt
}

% MULTI-LINE EQUATION SPACING
\setlength{\arraycolsep}{5pt}  % Optimized for Pagella's width

%% FIX (#85, ADR-0006): the grideqnarray and gridgather environments were
%% removed with the rest of the public grid API. Each wrapped a standard
%% amsmath environment in one quantum-fraction adjustment; documents use
%% `align` and `gather` and set \jot or \vspace themselves if they must.

% OPERATOR AND SYMBOL SPACING
% Fine-tuned for Pagella's wider proportions
\thinmuskip=3.6mu plus 1.2mu minus 1.2mu       % 20% increase for clarity
\medmuskip=4.8mu plus 2.4mu minus 1.2mu        % Binary operators
\thickmuskip=6.0mu plus 3.0mu minus 1.2mu      % Relational operators

% v3 (issue #84) removed the generic math wrappers \mathbinx, \mathrelx,
% \dint, \ssup, \ssub and the \lim redefinition; \lim keeps its standard
% amsmath meaning. Math spacing (mu-skips above) and the fraction-rule weight
% below are retained typography.

% FRACTION RULE WEIGHT
% Optical adjustment for Pagella's weight and proportions
\setlength{\fboxrule}{0.5pt}  % Match fraction rule to Pagella's weight

% THEOREM AND PROOF ENVIRONMENTS
% Professional mathematical document structure
% Note: Theorem styles require amsthm package which is loaded separately
% The following would be used with amsthm:
% \newtheoremstyle{pagellathm}%  % Name
