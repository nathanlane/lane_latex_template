% ELEGANT SMALL CAPS COMMAND
% Enhanced small caps with superior visibility and elegance
%% FIX(#39): drop dead global \SetTracking{...}{80}; the T1 sc list at
%% lnpmicrotype.sty:74 already sets the amount at normalsize, so bare \lsstyle
%% preserves current rendering (and outer kerning) with no override message.
\newcommand{\refinedsc}[1]{%
  {\scshape\lsstyle #1}%
}
%% FIX(#39): drop dead \SetTracking{...}{100}; bold sc resolves via the T1
%% bold-sc list (lnpmicrotype.sty:82), so \lsstyle is render-neutral.
\newcommand{\refinedscbold}[1]{%
  {\bfseries\scshape\lsstyle #1}%
}
% Title page small caps with refined tracking
%% FIX(#39): explicit \fontsize{11pt} matches no named-size sc list, so {50} was
%% effective; \textls[50] reproduces the original (like \abstractopening above).
\newcommand{\titlesc}[1]{%
  {\fontsize{11pt}{13pt}\selectfont\scshape\textls[50]{#1}}%
}

% Compatibility aliases for backward compatibility
%% FIX: Define compatibility aliases lazily so modules can load in either order.
\newcommand{\elegantsc}[1]{\refinedsc{#1}}
\newcommand{\elegantscbold}[1]{\refinedscbold{#1}}
\newcommand{\elegantbullet}{%
  \@ifundefined{refinedbullet}{\textcolor{subtlegray}{\raisebox{0.1ex}{\scalebox{0.75}{$\bullet$}}}}{\refinedbullet}%
}
\newcommand{\elegantdot}{\textcolor{subtlegray}{\raisebox{0.15ex}{\scalebox{0.65}{\textbullet}}}}
\newcommand{\elegantdash}{%
  \@ifundefined{refineddash}{\textcolor{subtlegray}{\kern0.05em\textendash\kern0.05em}}{\refineddash}%
}
\newcommand{\elegantcircle}{\textcolor{subtlegray}{\raisebox{0.1ex}{\scalebox{0.55}{$\circ$}}}}

