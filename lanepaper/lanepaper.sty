% ==============================================================================
% LANEPAPER.STY - Academic Typography Package
% ==============================================================================
%
% A comprehensive LaTeX style package for academic typography excellence,
% implementing principles from three foundational typographic works:
%
% PRIMARY REFERENCES:
%   [1] Butterick, M. (2019). Practical Typography, 2nd ed.
%       https://practicaltypography.com
%   [2] Brown, T. (2018). Flexible Typographic Systems. A Book Apart.
%   [3] Hochuli, J. (1987/2008). Detail in Typography. Hyphen Press.
%
% DESIGN PHILOSOPHY:
%   - Reader-focused optimization (Butterick)
%   - Mathematical harmony via modular scale (Brown) 
%   - Micro-typographic excellence (Hochuli)
%   - Chicago Manual of Style compliance
%   - Restrained colour hierarchy
%
% TECHNICAL REQUIREMENTS:
%   - LaTeX 2e (2020/10/01 or later, for format-native \AddToHook)
%   - pdfTeX only (pdfLaTeX); see the engine guard below
%   - TeX Live 2025 is the supported production baseline (ADR-0006)
%
% USAGE:
%   \usepackage{lanepaper}                   % The sole public load path
%   \usepackage[optical]{lanepaper}          % Add the sourced optical refinements
%   \usepackage[nocolor]{lanepaper}          % Grayscale hierarchy, no chroma
%
% The lnp*.sty files are internal owners, not entry points: load lanepaper and
% nothing else (ADR-0006). The document keeps its own bibliography,
% cross-reference, and appendix packages. Only visible hyperref and longtable
% typography is configured if those packages are loaded (ADR-0003).
%
% PACKAGE OPTIONS:
%   optical  - Sourced optical refinements over the defaults (runt control)
%   nocolor  - Convert the palette to grayscale, keeping its hierarchy
%
% DOCUMENTATION:
%   - API_REFERENCE.md (commands, systems, and typography standards)
%   - Inline comments throughout this file
%
% ==============================================================================

\NeedsTeXFormat{LaTeX2e}[2020/10/01]
\ProvidesPackage{lanepaper}[2026/08/12 v2.0 Academic Typography - Package Options]

% ==============================================================================
% ENGINE GUARD
% ==============================================================================
% This package is pdfLaTeX-only. The font stack is 8-bit and pdfTeX-shaped --
% T1 fontenc, utf8 inputenc, newpxmath, mathalfa, zi4 and Type1 tgpagella --
% with no fontspec path, and microtype font expansion is unsupported on XeTeX.
% Without this guard a XeLaTeX or LuaLaTeX user gets a cascade of font errors
% instead of one message saying what is wrong.
\RequirePackage{iftex}
\ifpdftex\else
  \PackageError{lanepaper}{%
    pdfTeX is required, but this document is being compiled with another engine%
  }{%
    lanepaper is pdfLaTeX-only.\MessageBreak
    Its font stack (T1 fontenc, utf8 inputenc, newpxmath, mathalfa, zi4,\MessageBreak
    Type1 tgpagella) has no fontspec path, and microtype font expansion\MessageBreak
    is unsupported on XeTeX.\MessageBreak
    Compile with pdflatex.%
  }%
  %% Stop the run. Without this the error is recoverable, so a nonstopmode
  %% build continues into exactly the font cascade this guard exists to
  %% prevent -- microtype alone adds two more errors on XeTeX.
  \batchmode\@@end
\fi

% ==============================================================================
% PACKAGE OPTIONS
% ==============================================================================
%
% Two options, and no template modes (ADR-0006). [grid], [minimal], [draft],
% [natbib], [nobiblatex] and the subsection-barrier pair were v2 surfaces for
% a template that also shipped alternative entry points; v3 is one package
% with one load path, so they are removed outright rather than aliased or
% left inert. A document passing one now gets LaTeX's own "Unknown option".
%
% optical (default: off)
%   - Adds optical refinements that have a stated source but are not safe to
%     impose on every document. Currently: runt control, capping the last
%     line's stretch so it reaches at least a third of the measure
%     (Hochuli, Detail in Typography). Defaults such as widow and orphan
%     protection are NOT here -- they belong to every document.
%   - Usage: \usepackage[optical]{lanepaper}
%
% nocolor (default: off)
%   - Converts the semantic palette through xcolor's gray model. Chroma goes;
%     the grayscale hierarchy between heading levels stays.
%   - Usage: \usepackage[nocolor]{lanepaper}
%   - Use case: single-ink printing, or a journal that requires it.
%
% ------------------------------------------------------------------------------

\newif\iflnp@optical
\newif\iflnp@nocolor

\DeclareOption{optical}{\lnp@opticaltrue}
\DeclareOption{nocolor}{\lnp@nocolortrue}

\ProcessOptions\relax

%% Issue #48 (ADR-0003 rule 2): the bibliography belongs to the document.
%% This package loaded biblatex with its own option set, which fixed the
%% backend, style and sorting for every document using it and forced anyone
%% wanting different options to pass [nobiblatex] and load it themselves.
%%
%% It configures nothing about biblatex -- there is no \DeclareFieldFormat,
%% \ExecuteBibliographyOptions or bibmacro anywhere in lanepaper/ -- so rule 2
%% leaves only the removal. Load biblatex (or natbib) in the document.
%% demo/preamble.tex shows the option set this package used to apply.
\@ifpackageloaded{biblatex}{%
  \PackageInfo{lanepaper}{biblatex detected}%
}{%
  \@ifpackageloaded{natbib}{%
    \PackageInfo{lanepaper}{natbib detected}%
  }{%
    \PackageInfo{lanepaper}{No bibliography package loaded; the document owns
      its bibliography since issue #48}%
  }%
}

