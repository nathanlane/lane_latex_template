% Title page footnote configuration
% Saves and restores footnote settings for main document
% Title pages require tighter spacing due to centered content and visual balance
\newcommand{\titlefootnotesetup}{%
  \setcounter{footnote}{0}%
  \renewcommand{\thefootnote}{\fnsymbol{footnote}}%
  % Title page needs tighter spacing before footnotes due to centered layout
  \setlength{\skip\footins}{\lnp@gridunit}%
  \addtolength{\skip\footins}{0pt plus 2pt minus 1pt}  % 1 quantum (vs 2 for main)
  \setlength{\footnotesep}{0.75\lnp@gridunit}   % 0.75 quanta - balanced separation
  % Use EXACT same formatting as main document
  \renewcommand{\@makefntext}[1]{%
    \setlength{\parindent}{11.5pt}% Same as main (widened marker box)
    \noindent
    \makebox[11.5pt][l]{%
      \fontsize{6}{7}\selectfont  % Same as main
      %% FIX(#39): 6pt roman marker matches no tracking list, so its {50} was
      %% effective; \textls[50] preserves it (fixed \makebox -> raster-neutral).
      \textls[50]{\@thefnmark}% Same as main
    }%
    \fontsize{8.5}{10}\selectfont % Back to normal leading
    \spaceskip=0.35em plus 0.175em minus 0.14em  % Same as main
    ##1%
  }
  % Title page rule - gray and shorter, but same spacing as main
  \renewcommand{\footnoterule}{%
    \vspace*{-3pt}% Same as main document
    \textcolor{gray!20}{\hrule width 2in height 0.5pt}% Gray 2in (title specific style)
    \vspace*{\lnp@gridunit}% Same as main: 1 quantum to first footnote
  }%
}

\newcommand{\titlefootnotereset}{%
  \setcounter{footnote}{0}%
  \renewcommand{\thefootnote}{\arabic{footnote}}%
  % Restore main document footnote spacing
  \setlength{\skip\footins}{2\lnp@gridunit}%
  \addtolength{\skip\footins}{0pt plus 2pt minus 1pt}  % Back to 2 quanta
  \setlength{\footnotesep}{0.25\lnp@gridunit}   % Back to 0.25 quanta
  % Restore main document footnote formatting
  \renewcommand{\@makefntext}[1]{%
    \setlength{\parindent}{11.5pt}%
    \noindent
    \makebox[11.5pt][l]{%
      \fontsize{6}{7}\selectfont
      %% FIX(#39): 6pt roman marker matches no tracking list, so its {50} was
      %% effective; \textls[50] preserves it (fixed \makebox -> raster-neutral).
      \textls[50]{\@thefnmark}% Regular tracking
    }%
    \fontsize{8.5}{10}\selectfont % Back to 8.5pt/10pt
    \spaceskip=0.35em plus 0.175em minus 0.14em
    ##1%
  }
  % Restore standard footnote rule
  \renewcommand{\footnoterule}{%
    \vspace*{-3pt}%
    \textcolor{lnp@textblack}{\hrule width 0.33\textwidth height 0.4pt}%
    \vspace*{\lnp@gridunit}%
  }%
}

% ==============================================================================
% VIII. PROFESSIONAL FOOTNOTE SYSTEM
% ==============================================================================
%
% Implements the combined principles of all three masters:
% - Butterick: Systematic sizing relationships and optimal readability
% - Brown: Modular scale proportions (8pt superscript, 9pt text)
% - Hochuli: Precise spacing, hanging indents, and baseline alignment
%
% SIZING HIERARCHY (Optimized for Pagella per foundry standards):
%   Superscript: 6pt (70% of footnote size) with +50 units tracking
%   Footnote text: 8.5pt (77% of body); actual footnote leading is 12pt
%   Hanging indent: 11.5pt (fits three-digit old-style markers)
%
% SPACING SYSTEM (Grid-compliant):
%   Rule position: 26.4pt below main text (2 quanta)
%   Rule to footnote: 13.2pt (1 quantum)
%   Between footnotes: 3.3pt (0.25 quanta)
%   Rule width: 33% of text measure, 0.4pt thickness
%
% REFERENCES:
%   - Butterick, M. (2019). Practical Typography. Chapter on footnotes.
%   - Brown, T. (2018). Flexible Typographic Systems. Modular relationships.
%   - Hochuli, J. (1987). Detail in Typography. Chapter on small text.
%
% ------------------------------------------------------------------------------

% FOOTNOTE PACKAGE CONFIGURATION
%% FIX: dropped the inert [hang,flushmargin] options — Lane's \@makefntext
%% below replaces footmisc's implementation wholesale, so the options and
%% their comment described behavior the package cancels. To pass footmisc
%% options (e.g. bottom), use \PassOptionsToPackage{bottom}{footmisc} BEFORE
%% loading lanepaper; loading footmisc directly afterwards causes an
%% option clash.
\RequirePackage{footmisc} % Footnote layout hooks (\@footnotemark etc.)
% fnpct package permanently removed due to fatal compilation conflicts

% Professional foundry specifications for Pagella
% Footnote text: 8.5pt (77% of 11pt body) - maintains readability
% Superscript: 6pt (70% of 8.5pt footnote) - clear subordination
% Leading: 11pt (aligns with 0.833 grid lines for recovery)

% Butterick's size relationships with systematic proportions
\renewcommand\@makefntext[1]{%
  %% FIX: marker box widened 7pt -> 11.5pt. Measured at the marker's 6pt/+50
  %% tracking, Pagella's tabular old-style digits are 3.6pt each:
  %% \oldstylenums{99} = 7.2pt already overflowed the 7pt box (hidden by
  %% \hfuzz=0.2pt; PDF extraction concatenated marker and word, e.g.
  %% "16Our"), and \oldstylenums{999} = 10.8pt overprinted the note text.
  %% 11.5pt fits three digits with 0.7pt to spare.
  \setlength{\parindent}{11.5pt}%
  \noindent
  \makebox[11.5pt][l]{%
    % Foundry spec: 6pt superscript with tracking
    \fontsize{6}{7}\selectfont
    %% FIX(#39): 6pt roman marker matches no tracking list, so its {50} was
    %% effective; \textls[50] preserves it (fixed \makebox -> raster-neutral).
    \textls[50]{\@thefnmark}% +50 units tracking
  }%
  %% FIX: \linespread{1.20} scales this 10pt leading to a real 12pt footnote
  %% baseline (measured); the "10pt" claim was wrong in three directions.
  \fontsize{8.5}{10}\selectfont
  % Optimized word spacing for small text (Pagella's generous x-height)
  \spaceskip=0.35em plus 0.175em minus 0.14em
  #1%
}

% Professional grid-aligned spacing per foundry standards
% Space before footnote block calculated for optimal grid recovery
\setlength{\skip\footins}{2\lnp@gridunit}%
\addtolength{\skip\footins}{0pt plus 2pt minus 1pt}  % 2 quanta to rule
%% FIX: \footnotesep is not inter-note space — LaTeX inserts it as a floor on
%% each note's first-line height. 0.25\lnp@gridunit = 3.3pt sits below the
%% footnote strut (~8.4pt at the 12pt footnote baseline), so it is inert;
%% between-note separation comes from the footnote \baselineskip. Value kept
%% (any effective value would change rendering); comment corrected.
\setlength{\footnotesep}{0.25\lnp@gridunit}   % inert floor below the footnote strut (~8.4pt)

% Hochuli: Prevent footnote orphans (footnote split across pages)
\interfootnotelinepenalty=10000

% Professional footnote rule per foundry specifications
% Rule at 33% text width, positioned 2 quanta below main text
\renewcommand{\footnoterule}{%
  \vspace*{-3pt}% Fine adjustment for rule positioning
  \textcolor{lnp@textblack}{\hrule width 0.33\textwidth height 0.4pt}% 33% width, hairline
  \vspace*{\lnp@gridunit}% 1 quantum to first footnote baseline
}

% Brown's systematic approach: Consistent footnote numbering
% Use old-style figures if available in Pagella
\renewcommand{\thefootnote}{\oldstylenums{\arabic{footnote}}}

% Hochuli detail: footnote text begins unbreakable
\let\oldfootnote\footnote
%% FIX: Preserve LaTeX's optional footnote mark API. The \nobreak is inserted
%% at the start of the footnote *text*; an earlier comment claimed it prevents
%% footnote marks from breaking, which it does not do.
\renewcommand{\footnote}[2][]{%
  \if\relax\detokenize{#1}\relax
    \oldfootnote{\nobreak#2}%
  \else
    \oldfootnote[#1]{\nobreak#2}%
  \fi
}

% Additional footnote optimizations for professional typography
% Ensure consistent measurements throughout document
\AddToHook{begindocument}{%
  %% FIX: \footnotemargin setting removed — it only takes effect through
  %% footmisc's hang/flushmargin options, which this package does not pass
  %% (footmisc itself is still loaded, and this package's own \@makefntext
  %% replaces the layout anyway). It was dead code contradicting the dead
  %% flushmargin option.
  % Enable hyphenation in footnotes with constraints
  \hyphenpenalty=1000  % Tighter constraints for footnotes
  \exhyphenpenalty=2000  % Maximum 2 consecutive hyphens
}

% Fine-tuning for multiple footnotes on same reference
% Adds thin space between consecutive footnote marks
\newcommand{\multiplefootnotes}[1]{%
  \textsuperscript{\kern0.05em#1}%
}

% Professional kerning configuration for footnote marks
% Manual footnote punctuation handling (fnpct replacement)
% Footnote punctuation must be ordered manually (punctuation before footnote mark)
% Ensures footnote marks appear after punctuation in correct position

% ==============================================================================
% VIII. MODULAR SCALE TYPOGRAPHY SYSTEM
% ==============================================================================
%
% Implements Tim Brown's modular scale methodology using the Perfect Fourth 
% ratio (1.333) to create mathematically harmonious typographic hierarchy.
% All sizing relationships derive from the 11pt base text size.
%
% MATHEMATICAL FOUNDATION:
%   Base: 11pt (body text)
%   Scale: Perfect Fourth ratio = 1.333
%   Progression: 11pt → 14.7pt → 19.6pt (theoretical)
%   Adjusted: 11pt → 12pt → 14pt → 18pt (visually optimized for LaTeX)
%
% HIERARCHY MAPPING:
%   \section:        18pt (1.333³ from base)
%   \subsection:     14pt (1.333¹ from base)  
%   \subsubsection:  12pt (1.333^0.5 from base)
%   \paragraph:      11.5pt (base + small caps enhancement)
%   Body text:       11pt (base)
%
% REFERENCES:
%   - Brown, T. (2018). Flexible Typographic Systems. A Book Apart.
%   - Brown, T. (2011). More Meaningful Typography. A List Apart.
%   - modularscale.com - Interactive modular scale calculator
%
% ------------------------------------------------------------------------------

% Section formatting has been moved to lnpheadings.sty

%% FIX (#86, ADR-0003): Appendix orchestration is document-owned. Lanepaper
%% leaves the standard \appendix command and any document-selected package intact.

% ==============================================================================
% X. CORE FUNCTIONALITY AND INTEGRATION
% ==============================================================================
%
% Final package loading and integration for essential functionality:
% - Graphics and table support
% - Hyperref with professional styling (configured if loaded)
% - Final formatting and compatibility adjustments
%
% PACKAGE LOADING ORDER:
%   Graphics packages provide figure and table support
%   Booktabs ensures professional table formatting
%
% HYPERREF CONFIGURATION:
%   - Professional color scheme matching document palette
%   - PDF metadata for academic publishing
%   - Visible link formatting that matches the package palette
%
% REFERENCES:
%   - LaTeX Graphics Companion (2nd ed.)
%   - Hyperref package documentation
%
% ------------------------------------------------------------------------------

% ESSENTIAL PACKAGE LOADING
% Table and page-style support
%% FIX (#86): lnplists owns and loads graphicx for its scaled markers; the
%% master package no longer owns image helpers or needs a duplicate load.
\RequirePackage{array}           % Enhanced array and tabular environments
\RequirePackage{booktabs}        % Professional table design (no vertical rules)
%% Issue #48 (ADR-0003 rule 2): longtable is configured if the document loads
%% it, never loaded here. See the guarded block below.
% ltcaption removed - modern longtable handles captions natively
\RequirePackage{fancyhdr}        % Custom headers and footers
%% Issue #48 (ADR-0003 rule 2): hyperref is configured if loaded, never loaded.
%% Loading hyperref here would dictate load order to every document using this
%% package -- the single most likely thing to break an adopter. Since v3
%% (issue #84) cleveref is no longer configured either; cross-references are
%% fully document-owned (ADR-0003 rule 3).

% ==============================================================================
% QUANTUM-SPACED TABLE ROW SYSTEM
% ==============================================================================
%
% Implements quantum-multiple spacing for tables following professional
% typography standards. Tables keep a consistent vertical rhythm
% through precise row height control.
%
% KEY PRINCIPLES:
%% FIX: rows do not align to a 13.2pt baseline (baseline is 16.32pt);
%   - Table row heights derive from \arraystretch × the 16.32pt baseline
%   - Multiple grid alignment options for different table densities
%   - Maintains compatibility with regression tables and academic formats
%   - Works seamlessly with booktabs for professional appearance
%
% REFERENCES:
%   - Hochuli, J. (1987). Grid systems in typography
%   - Müller-Brockmann, J. (1981). Grid Systems in Graphic Design
%   - Professional typography standards for academic tables
%
% ------------------------------------------------------------------------------

% Cleveref configuration and reference wrappers removed in v3 (issue #84);
% cross-references are document-owned (ADR-0003 rule 3). \ref/\eqref untouched.

% BOOKTABS, ARRAY, AND LONGTABLE CONFIGURATION
% Configure table packages after loading
\setlength{\aboverulesep}{0pt}          % Remove space above booktabs rules
\setlength{\belowrulesep}{0pt}          % Remove space below booktabs rules
\setlength{\extrarowheight}{2.2pt}       % Extra row height; standard row measures 21.8pt (\arraystretch 1.2 × 16.32pt baseline + 2.2pt), not 13.2pt
%% Issue #48: longtable typography, applied only if the document loaded it.
%% \LTcapwidth is longtable's own length, so setting it unguarded is an
%% undefined control sequence for any document that does not load longtable.
\AddToHook{package/longtable/after}{%
  \setlength{\LTcapwidth}{\textwidth}%
  \AtBeginEnvironment{longtable}{\lnp@tablecaptionsetup}%
}

%% FIX (#85, ADR-0006): the grid table environments (gridtable,
%% compactgridtable, spaciousgridtable) and the \arraystretch aliases
%% (\standardgrid, \compactgrid, \spaciousgrid, \customgrid) were removed
%% with the rest of the public grid API. Each wrapped one
%% \renewcommand{\arraystretch}{...} inside a standard `table`, which a
%% document writes for itself.

% PROFESSIONAL TABLE DEFAULTS
% Global settings for all tables (can be overridden locally)
\renewcommand{\arraystretch}{1.2}       % Standard grid alignment by default
\setlength{\tabcolsep}{8pt}             % Professional column spacing

%% FIX (#85, ADR-0006): the grid-aligned image system (\roundtogrid,
%% \gridincludegraphics, \imagegridspace, gridfigure) was removed. It existed
%% to round image heights to quantum multiples, which is exactly the public
%% grid arithmetic v3 retires; \includegraphics inside a standard `figure`
%% is what remains.

%% Issue #48 (ADR-0003 rule 2): hyperref is configured here, never loaded.
%% The package's own load hook fires exactly when hyperref loads -- before or
%% after this package -- and never fires if it is absent. An inline
%% \@ifpackageloaded would run first and silently configure nothing, because
%% hyperref is conventionally loaded late.
%% FIX (#85, ADR-0003): retain only visible link styling. Bookmark numbering,
%% borders and encoding belong to the document. The old PDF-string fallbacks
%% covered standard LaTeX or microtype commands; the sole Lanepaper name was
%% private to front matter, which generates no bookmarks.
\AddToHook{package/hyperref/after}{%
  \hypersetup{
    colorlinks=true,
    linkcolor=lnp@linknavy,
    citecolor=lnp@linknavy,
    urlcolor=lnp@linknavy,
    filecolor=lnp@linknavy
  }%
}

% Butterick's final polish: Ensure proper page breaking
\raggedbottom              % Prevents awkward stretched spacing
% Note: \sloppy removed for Overleaf compatibility

% ==============================================================================
% XI. MATHEMATICAL TYPOGRAPHY OPTIMIZATION
% ==============================================================================
%
% Implements sophisticated mathematical typography following Knuth's principles
% with specific optimizations for TeX Gyre Pagella and the 13.2pt spacing quantum.
%
% DESIGN PHILOSOPHY:
%   - Knuth: "Mathematics must harmonize with surrounding text"
%   - Butterick: "Mathematical notation should be readable, not just correct"
%   - Hochuli: "Micro-adjustments create macro-improvements"
%   - Brown: Systematic size relationships via modular scale
%
% PAGELLA-SPECIFIC CONSIDERATIONS:
%   - Larger x-height (464/1000em) requires adjusted inline sizing
%   - Wider characters (~110% of CM) need more operator spacing
%   - Higher stroke contrast benefits from optical corrections
%   - 10° italic angle (vs CM's 14°) affects script positioning
%
% REFERENCES:
%   - Knuth, D. (1986). The TeXbook. Addison-Wesley.
%   - Downes, M. (2002). Technical Notes on the amsmath Package. AMS.
%   - Sharpe, M. (2024). The newpx package documentation. CTAN.
%
% ------------------------------------------------------------------------------

% DISPLAY EQUATION SPACING
% Values in spacing quanta; flexibility lets TeX compose pages. Rationale
% (ADR-0005): a multi-line display reads as one object, so compact internal
% leading binds its rows while \abovedisplayskip separates the block from
% prose; maths rows carry their own vertical bulk and \lineskip guards
% collisions. Display rows land on no grid; nothing here aligns to one.
\abovedisplayskip=1.5\lnp@gridunit plus 0.25\lnp@gridunit minus 0.25\lnp@gridunit    % 19.8pt ±3.3pt
\belowdisplayskip=1.5\lnp@gridunit plus 0.25\lnp@gridunit minus 0.25\lnp@gridunit    % 19.8pt ±3.3pt
\abovedisplayshortskip=1\lnp@gridunit plus 0.25\lnp@gridunit minus 0.25\lnp@gridunit  % 13.2pt ±3.3pt
\belowdisplayshortskip=1\lnp@gridunit plus 0.25\lnp@gridunit minus 0.25\lnp@gridunit  % 13.2pt ±3.3pt

% Multi-line equation spacing
%% FIX: the unconditional \AtBeginDocument \addtolength below adds another
%% 0.25\lnp@gridunit, so \jot ships as 9.9pt (measured), not 6.6pt. Value kept;
%% the claim is corrected here and there.
\jot=0.5\lnp@gridunit  % 0.5 quanta (6.6pt) before the begindocument-hook addition (ships as 9.9pt)

% Optimized script sizes for Pagella readability
%% FIX: the document body runs at 10.95pt (the class's 11pt option), so the
%% previous {11} key never fired and script sizes fell back to the class
%% defaults (measured scriptscript 6.1pt, not the declared 6pt). Keyed to
%% 10.95 so the declaration actually applies.
\DeclareMathSizes{10.95}{10.95}{8}{6}  % text, script, scriptscript, tiny

%% FIX: applies to EVERY multi-line display (the addition is unconditional),
%% despite the earlier "numbered equations" claim. In-force \jot = 9.9pt.
\AddToHook{begindocument}{%
  \addtolength{\jot}{0.25\lnp@gridunit}  % +0.25 quanta: total \jot = 9.9pt
}

% MULTI-LINE EQUATION SPACING
\setlength{\arraycolsep}{5pt}  % Optimized for Pagella's width

%% FIX (#85, ADR-0006): the grideqnarray and gridgather environments were
%% removed with the rest of the public grid API. Each wrapped a standard
%% amsmath environment in one quantum-fraction adjustment; documents use
%% `align` and `gather` and set \jot or \vspace themselves if they must.

% OPERATOR AND SYMBOL SPACING
% Fine-tuned for Pagella's wider proportions
\thinmuskip=3.6mu plus 1.2mu minus 1.2mu       % 20% increase for clarity
\medmuskip=4.8mu plus 2.4mu minus 1.2mu        % Binary operators
\thickmuskip=6.0mu plus 3.0mu minus 1.2mu      % Relational operators

% v3 (issue #84) removed the generic math wrappers \mathbinx, \mathrelx,
% \dint, \ssup, \ssub and the \lim redefinition; \lim keeps its standard
% amsmath meaning. Math spacing (mu-skips above) and the fraction-rule weight
% below are retained typography.

% FRACTION RULE WEIGHT
% Optical adjustment for Pagella's weight and proportions
\setlength{\fboxrule}{0.5pt}  % Match fraction rule to Pagella's weight

% THEOREM AND PROOF ENVIRONMENTS
% Professional mathematical document structure
% Note: Theorem styles require amsthm package which is loaded separately
% The following would be used with amsthm:
% \newtheoremstyle{pagellathm}%  % Name
%   {13.2pt}%                     % Space above (1 quantum)
%   {13.2pt}%                     % Space below (1 quantum)
%   {\itshape}%                   % Body font
%   {0pt}%                        % Indent amount
%   {\bfseries}%                  % Theorem head font
%   {.}%                          % Punctuation after theorem head
%   {.5em}%                       % Space after theorem head
%   {}%                           % Theorem head spec
% \theoremstyle{pagellathm}

% DISPLAY MATH CENTERING
% Ensure equations respect the grid
\g@addto@macro\normalsize{%
  \setlength{\abovedisplayskip}{1.5\lnp@gridunit plus 0.25\lnp@gridunit minus 0.25\lnp@gridunit}%
  \setlength{\belowdisplayskip}{1.5\lnp@gridunit plus 0.25\lnp@gridunit minus 0.25\lnp@gridunit}%
  \setlength{\abovedisplayshortskip}{1\lnp@gridunit plus 0.25\lnp@gridunit minus 0.25\lnp@gridunit}%
  \setlength{\belowdisplayshortskip}{1\lnp@gridunit plus 0.25\lnp@gridunit minus 0.25\lnp@gridunit}%
}

% ==============================================================================
% XII. FINAL TYPOGRAPHY REFINEMENTS
% ==============================================================================
%
% Final adjustments for optimal typography following Hochuli's attention to
% detail and Butterick's professional polish principles.
%
% HYPHENATION OPTIMIZATION:
%   - Moderate discouragement prevents excessive hyphenation
%   - Allow breaks after explicit hyphens (compound words)
%   - Prevent consecutive hyphenated lines (visual disruption)
%
% PAGE BREAKING:
%   - Raggedbottom prevents awkward stretched spacing
%   - Professional page composition for academic documents
%
% REFERENCES:
%   - Hochuli, J. (1987). Detail in Typography. Final details chapter.
%   - Butterick, M. (2019). Practical Typography. Professional polish.
%
% ------------------------------------------------------------------------------

% ==============================================================================
% HYPHENATION AND LINE BREAKING SYSTEM
% ==============================================================================
%
% Sophisticated paragraph optimization following:
% - Knuth: The TeXbook principles for optimal breaking
% - Hochuli: Refined spacing for readability
% - Pagella-specific: Adjustments for wider characters
%
% PHILOSOPHY:
%   Quality over convenience - we prefer slightly tighter spacing
%   over excessive hyphenation or overly loose lines
%
% ------------------------------------------------------------------------------

% BALANCED HYPHENATION PENALTIES
% Pagella's larger characters make hyphens more visible
\hyphenpenalty=1000         % Increased: discourage but allow when needed
\exhyphenpenalty=1000       % Match regular for consistency
\brokenpenalty=2000         % Moderate: prevent page breaks after hyphens
\doublehyphendemerits=12000 % Strong: prevent consecutive hyphenated lines
\finalhyphendemerits=8000   % Strong: very visible in Pagella
\adjdemerits=12000          % Strong: prevent loose/tight line alternation

% SPECIAL BREAKING PENALTIES
\binoppenalty=2000          % Discourage breaks after binary operators
\relpenalty=1500            % Discourage breaks after relations
\predisplaypenalty=10000    % Keep 2+ lines before display math
\postdisplaypenalty=2000    % Some flexibility after math

% OPTIMIZED LINE BREAKING FOR PAGELLA
% Tighter tolerances due to naturally wider characters
\pretolerance=150           % First pass without hyphenation
\tolerance=800              % Second pass (reduced from 1000)
\emergencystretch=1em       % Last resort (reduced from 3em)
%% FIX: comment said "Tighter overfull tolerance" but LaTeX's default \hfuzz
%% is 0.1pt — 0.2pt is *looser*. Value kept (changing it would surface new
%% overfull warnings); comment corrected.
\hfuzz=0.2pt               % Slightly relaxed overfull tolerance (default: 0.1pt)
\vfuzz=0.2pt               % Matching vertical tolerance

% PARAGRAPH COMPOSITION
\linepenalty=10            % Standard per-line penalty
\parfillskip=0pt plus 1fil % Standard paragraph ending

% ------------------------------------------------------------------------------
% [optical] -- SOURCED REFINEMENTS
% ------------------------------------------------------------------------------
% Refinements with a stated source that are not safe to impose by default.
% Defaults such as the widow and orphan penalties above are deliberately NOT
% here: every document wants those (ADR-0006).
%
% RUNT CONTROL. A paragraph's last line should reach at least a third of the
% measure; a one- or two-word last line reads as a hole in the block
% (Hochuli, Detail in Typography, on paragraph endings). The \parfillskip
% just above is LaTeX's own 0pt plus 1fil, which lets the last line be
% arbitrarily short at no cost. Capping the stretch makes TeX pay for a runt
% and rebreak the paragraph instead.
%
% It is opt-in because it is a real trade: a paragraph that cannot be
% rebroken pays in interword spacing or an overfull line, and that is the
% document's call, not the package's. Assigning it here, at the one site that
% owns \parfillskip, is what keeps the two from fighting.
\iflnp@optical
  \parfillskip=0pt plus 0.7\textwidth
\fi
%% FIX: duplicate \parindent assignment removed; lnpdimensions.sty sets the
%% identical \parindent=\lnp@gridunit (13.2pt) and always loads.

% RIVER PREVENTION
