\newcommand{\itsc}[1]{{\itshape\scshape\textls[20]{#1}}}
\newcommand{\headsc}[1]{{\bfseries\scshape\lsstyle #1}}
\newcommand{\inlinebsc}[1]{{\bfseries\scshape\lsstyle #1}}

% --- NESTED EMPHASIS HANDLERS ---

% Smart italic that reverses in italic context
\newcommand{\smartitalic}[1]{%
  \ifx\f@shape\itdefault
