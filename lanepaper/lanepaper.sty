% ==============================================================================
% V. SPACING QUANTUM AND SPACING SYSTEM
% ==============================================================================
%
% Implements systematic spacing based on a 13.2pt spacing quantum derived from
% Hochuli's principle that "consistent vertical rhythm improves readability."
% All spacing relationships derive from this fundamental unit.
%
% MATHEMATICAL BASIS:
%   Base text: 10.95pt (the class's 11pt option)
%   Actual leading: 13.6pt × \linespread{1.20} = 16.32pt (measured)
%   Spacing quantum: 13.2pt (11pt × 1.20 nominal) — a spacing unit, NOT the
%   baseline; see docs/adr/0004-baseline-grid-is-a-spacing-quantum.md
%   Half quantum: 6.6pt (paragraph spacing, footnote separation)
%
% REFERENCES:
%   - Hochuli, J. (1987). Detail in Typography. Chapter on vertical rhythm.
%   - Butterick, M. (2019). Practical Typography. Chapter on line spacing.
%
% ------------------------------------------------------------------------------

% The 13.2pt spacing quantum lives in lnpdimensions.sty as \lnp@gridunit.
% It is an internal implementation value (ADR-0005, ADR-0006), not a grid API.

% Butterick's optimal line length: 45-90 characters (2-3 alphabets).
% The six-inch measure set in lnpdimensions gives ~65 characters in Pagella.

% Hochuli's detail: prevent widows/orphans more aggressively.
% These are defaults, not refinements: every document wants them, so they are
% deliberately not behind [optical] (ADR-0006).
\clubpenalty=10000
\widowpenalty=10000
\displaywidowpenalty=10000

% Additional perfectionist controls for Pagella
%% FIX: duplicate \brokenpenalty (5000 here, 2000 later) and
%% \postdisplaypenalty (10000 here, 2000 later) assignments removed; the
%% later, in-force values are kept so rendering is unchanged. The duplicate
%% \predisplaypenalty (same value both times) is kept at the later block.
\interlinepenalty=2500       % Discourage page breaks within paragraphs

% Prevent isolated section headings
\@secpenalty=-1000           % Encourage breaks before sections
\interfootnotelinepenalty=10000  % Prevent footnote splitting

% CLASSICAL PARAGRAPH INDENTATION SYSTEM
% Implements Bringhurst and Hochuli's principles for first paragraph handling
% First paragraphs after headings, lists, and breaks remain flush left

% Classical typography: first paragraphs after headings are flush left
\let\@afterindentfalse\@afterindenttrue
\@afterindentfalse  % Changed: flush left first paragraphs after headings

% Custom commands for controlling indentation in special contexts
%% FIX (#85): these were \providecommand so that a document preloading
%% lnpparagraphs would not clash. lnpparagraphs is not loaded by anything and
%% direct module loading is unsupported, so \newcommand is correct again: a
%% real name collision with another package should error at load time
%% (CONVENTIONS §8), not be silently swallowed.
\newcommand{\noindentpar}{\noindent\ignorespaces}     % Explicit flush left paragraph
\newcommand{\forceindent}{\hspace{\parindent}}        % Force indentation when needed

% Flexible paragraph style commands for different document needs
% Paragraph style commands are now in lnpdimensions.sty

% Deprecated spacing commands - use \vspace directly
\newcommand{\compactpar}{\vspace{-0.25\lnp@gridunit}}  % Legacy support
\newcommand{\loosepars}{\vspace{0.25\lnp@gridunit}}    % Legacy support
\newcommand{\centeredpar}[1]{%                 % Centered paragraph
  {\centering\noindent#1\par}%
}

% Dialogue support for narrative text
\newcommand{\dialogue}[1]{\par\indent #1\par}              % Standard dialogue with full indent

% Epigraph environment for quotations at chapter/section beginnings
\newenvironment{epigraph}{%
  \vspace{\lnp@gridunit}%                  % 1 quantum before
  \begin{flushright}%
  \begin{minipage}{0.618\textwidth}% Golden ratio width
  \raggedleft\itshape%
  \setlength{\parindent}{0pt}%
  \setlength{\parskip}{0.5\lnp@gridunit}%      % 0.5 quanta between paragraphs
}{%
  \end{minipage}%
  \end{flushright}%
  \vspace{\lnp@gridunit}%                  % 1 quantum after
  \@afterindentfalse%               % No indent after epigraph
}

% ==============================================================================
% PROFESSIONAL BLOCK QUOTATION SYSTEM
% ==============================================================================
%
% Implements sophisticated block quotation typography following master principles:
% - Butterick: Visual distinction without jarring contrast
% - Hochuli: Subtle differentiation through spacing and margins
% - Brown: Systematic relationships with modular scale
%
% DESIGN DECISIONS:
%   - Size: 10.5pt (95% of body) for subtle subordination
%% FIX: \fontsize{10.5}{13.2} under \linespread{1.20} gives a real 15.84pt
%   - Leading: 15.84pt measured (13.2pt × \linespread)
%   - Margins: 26.4pt (2 quanta) optimized for Pagella's width
%   - Color: 15% gray matching paragraph heading hierarchy
%   - Spacing: 1 quantum before/after with asymmetric flexibility
%
% ------------------------------------------------------------------------------

%% FIX (#85): \lnp@quotegray moved to lnpcolors, the palette's owner.

% STANDARD BLOCK QUOTE
% For quotations without paragraph breaks
%% FIX: Use \list with \endlist so quote environments close correctly.
\renewenvironment{quote}{%
  \vspace{\lnp@gridunit}%     % 1 quantum before
  \list{}{%
    \setlength{\leftmargin}{2\lnp@gridunit}%       % 2 quanta (Pagella proportion)
    \setlength{\rightmargin}{2\lnp@gridunit}%      % Symmetric margins
    \setlength{\topsep}{0pt}%              % Spacing handled explicitly
    \setlength{\partopsep}{0pt}%
    \setlength{\parsep}{0.5\lnp@gridunit}%            % 0.5 units between paragraphs
    \setlength{\itemsep}{0pt}%
    \setlength{\listparindent}{\parindent}%
    \fontsize{10.5}{13.2}\selectfont%      % 95% size, same leading
    \color{lnp@quotegray}%                     % 15% gray for subtle distinction
  }%
  \item\relax
}{%
  \endlist
  \vspace{\lnp@gridunit}%     % 1 quantum after
  \@afterindentfalse%                       % No indent after quote
}

% EXTENDED QUOTATION
% For quotations with multiple paragraphs
\renewenvironment{quotation}{%
  \vspace{\lnp@gridunit}%
  \list{}{%
    \setlength{\leftmargin}{2\lnp@gridunit}%
    \setlength{\rightmargin}{2\lnp@gridunit}%
    \setlength{\topsep}{0pt}%
    \setlength{\partopsep}{0pt}%
    \setlength{\parsep}{0.5\lnp@gridunit}%
    \setlength{\itemsep}{0pt}%
    \setlength{\listparindent}{\lnp@gridunit}%    % Maintain paragraph indent
    \fontsize{10.5}{13.2}\selectfont%
    \color{lnp@quotegray}%
  }%
  \item\relax
}{%
  \endlist
  \vspace{\lnp@gridunit}%
  \@afterindentfalse%
}

% PROFESSIONAL ATTRIBUTION SYSTEM
% For quote attributions with em-dash and right alignment
\newcommand{\quoteattribution}[1]{%
  \par\vspace{0.5\lnp@gridunit}%                       % 0.5 quanta
  \hfill{\fontsize{10}{13.2}\selectfont\color{lnp@subsubcolor}--- #1}%
  \par
}

% EMPHASIS QUOTE (renamed to avoid csquotes conflict)
% Dramatic presentation for important quotations
\newenvironment{emphasisquote}{%
  \vspace{1.5\lnp@gridunit}%     % 1.5 units before
  \list{}{%
    \setlength{\leftmargin}{3\lnp@gridunit}%       % 3 quanta
    \setlength{\rightmargin}{3\lnp@gridunit}%      % Dramatic inset
    \setlength{\topsep}{0pt}%
    \setlength{\partopsep}{0pt}%
    \setlength{\parsep}{0.5\lnp@gridunit}%
    \setlength{\itemsep}{0pt}%
    \fontsize{12}{15.84}\selectfont%       % Larger for emphasis (1.2× leading)
    \itshape\color{lnp@quotegray}%             % Italic for distinction
  }%
  \item\relax
}{%
  \endlist
  \vspace{1.5\lnp@gridunit}%     % 1.5 units after
  \@afterindentfalse%
}

% Special handling for environments that should not indent their first paragraph
\AtBeginEnvironment{itemize}{\parindent=0pt}
\AtBeginEnvironment{enumerate}{\parindent=0pt}
\AtBeginEnvironment{description}{\parindent=0pt}
\AtBeginEnvironment{quote}{\parindent=0pt}
\AtBeginEnvironment{quotation}{\parindent=\parindent}  % Quotation keeps normal indentation
\AtBeginEnvironment{emphasisquote}{\parindent=0pt}     % Emphasis quote no indent
\AtBeginEnvironment{verbatim}{\parindent=0pt}
\AtBeginEnvironment{figure}{\parindent=0pt}
\AtBeginEnvironment{table}{\parindent=0pt}

% Ensure first paragraph after environments is flush left
% Create a command for no indent that works at document level
\newcommand{\lnp@noindent}{\@afterindentfalse}

% Display environments: flush left paragraph follows
\AtEndEnvironment{itemize}{\lnp@noindent}
\AtEndEnvironment{enumerate}{\lnp@noindent}
\AtEndEnvironment{quote}{\lnp@noindent}
\AtEndEnvironment{emphasisquote}{\lnp@noindent}
\AtEndEnvironment{verbatim}{\lnp@noindent}
\AtEndEnvironment{figure}{\lnp@noindent}
\AtEndEnvironment{table}{\lnp@noindent}
% All display and list environments: flush left paragraph follows
\AtEndEnvironment{description}{\lnp@noindent}
\AtEndEnvironment{quotation}{\lnp@noindent}
\AtEndEnvironment{epigraph}{\lnp@noindent}

