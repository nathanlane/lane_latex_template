% ==============================================================================
% LNPHEADINGS.STY - Section and Heading Typography Module
% ==============================================================================
% Extracted from lanepaper.sty for modular customization
% Implements sophisticated heading hierarchy with quantum-multiple spacing
% ==============================================================================

\ProvidesPackage{lnpheadings}[2026/08/12 v1.1 Heading Typography System]

% Dependencies
\RequirePackage{titlesec}         % Custom section formatting
\RequirePackage{etoolbox}         % For \AtBeginEnvironment

% Ensure colors are loaded
\@ifpackageloaded{lnpcolors}{}{%
  % Silently load colors module if not already loaded
  \RequirePackage{lnpcolors}%
}

% Ensure dimensions are loaded for grid units
\@ifpackageloaded{lnpdimensions}{}{%
  % Silently load dimensions module if not already loaded
  \RequirePackage{lnpdimensions}%
}

% ==============================================================================
% SECTION HIERARCHY DESIGN
% ==============================================================================
% Implements Tim Brown's modular scale principles with Perfect Fourth ratio
%
% MODULAR SCALE (Perfect Fourth = 1.333):
%   Base: 11pt (body text)
%   Scale: Perfect Fourth ratio = 1.333
%   Progression: 11pt → 14.7pt → 19.6pt (theoretical)
%   Adjusted: 11pt → 12pt → 14pt → 18pt (visually optimized for LaTeX)
%
% HIERARCHY MAPPING:
%   \section:        18pt (1.333³ from base)
%   \subsection:     14pt (1.333¹ from base)  
%   \subsubsection:  12pt (1.333^0.5 from base)
%   \paragraph:      11.5pt (base + small caps enhancement)
%   Body text:       11pt (base)
% ==============================================================================

% Set section numbering depth
\setcounter{secnumdepth}{3}

% ==============================================================================
% SECTION SPACING STYLES
% ==============================================================================
% Commands to switch between different section spacing approaches

\newcommand{\spacioussections}{%
  % Original generous spacing (2 units before, 1 after)
  \titlespacing*{\section}{0pt}
    {2\gridunit plus 0.25\gridunit minus 0.25\gridunit}
    {1\gridunit plus 0.125\gridunit minus 0pt}
}

\newcommand{\moderatesections}{%
  % Moderate spacing (1.5 units before, 1 after) - DEFAULT
  \titlespacing*{\section}{0pt}
    {1.5\gridunit plus 0.25\gridunit minus 0.25\gridunit}
    {1\gridunit plus 0.125\gridunit minus 0pt}
}

\newcommand{\compactsections}{%
  % Compact spacing (1 unit before, 1 after)
  \titlespacing*{\section}{0pt}
    {1\gridunit plus 0.25\gridunit minus 0.25\gridunit}
    {1\gridunit plus 0.125\gridunit minus 0pt}
}

\newcommand{\tightsections}{%
  % Tight academic spacing (1 unit before, 0.5 after)
  \titlespacing*{\section}{0pt}
    {1\gridunit plus 0.25\gridunit minus 0.125\gridunit}
    {0.5\gridunit plus 0.125\gridunit minus 0pt}
}

% ==============================================================================
% SECTION FORMATTING
% ==============================================================================

% Sections: Bold with sophisticated color and tracking
% OPTIMIZED: Perfect grid alignment without optical adjustments
%% FIX: \SetTracking is global and lnpmicrotype's series=b rule annuls it on bold
%% headings, so the +80 was dead code that also churned the tracking list
%% document-wide on every heading (122 override messages per build).
\titleformat{\section}
  {\normalfont\fontsize{18}{26.4}\selectfont\bfseries\color{sectioncolor}}  % 18pt bold, softened navy
  {\thesection}
  {1em}
  {}  % No optical compensation - achieve alignment through leading
\titlespacing*{\section}
  {0pt}
  {1.5\gridunit plus 0.25\gridunit minus 0.25\gridunit}  % 1.5 units ±0.25 (reduced from 2)
  {1\gridunit plus 0.125\gridunit minus 0pt}    % 1 unit +0.125/-0 (unchanged)

% Subsections: Bold with moderate tracking and midnight blue
% OPTIMIZED: 19.8pt leading (1.5 grid units) for perfect alignment
%% FIX: same global-tracking conflict as \section; the +60 never took effect.
\titleformat{\subsection}
  {\normalfont\fontsize{14}{19.8}\selectfont\bfseries\color{subsectioncolor}}  % 14pt bold, muted midnight
  {\thesubsection}
  {0.85em}
  {}  % No optical compensation - proper leading ensures alignment
\titlespacing*{\subsection}
  {0pt}
  {1.5\gridunit plus 0.25\gridunit minus 0.125\gridunit}  % 1.5 units ±0.25/0.125 (reduced from 2)
  {0.75\gridunit plus 0.125\gridunit minus 0pt}      % 0.75 units +0.125/-0 (tighter)

% Subsubsections: Bold with charcoal color for softer impact
% OPTIMIZED: Single grid unit leading for tight alignment
\titleformat{\subsubsection}
  {\normalfont\fontsize{12}{13.2}\selectfont\bfseries\color{subsubcolor}}  % 12pt bold, charcoal
  {\thesubsubsection}
  {0.7em}
  {}
\titlespacing*{\subsubsection}
  {0pt}
  {1.5\gridunit plus 0.25\gridunit minus 0.125\gridunit}  % 1.5 units ±0.25/0.125
  {0.5\gridunit plus 0.125\gridunit minus 0pt}      % 0.5 units +0.125/-0 (reduced from 0.75)

% Paragraphs: Bold italic for contrast without blockiness
% OPTIMIZED: Exact body text size and leading for perfect integration
% Using runin format to avoid list environment conflicts
%% FIX: the [~] after-code combined with a 0pt after-value yielded zero
%% separation ("RobustnessEstimates"); titlesec drives run-in separation from
%% the after-value, so set it to 0.75em and drop the tie.
\titleformat{\paragraph}[runin]
  {\normalfont\fontsize{11}{13.2}\selectfont\bfseries\itshape\color{paragraphcolor}}  % 11pt bold italic, dark gray
  {}
  {0em}
  {}
\titlespacing*{\paragraph}
  {0pt}
  {1\gridunit plus 0.25\gridunit minus 0.125\gridunit}  % 1 unit ±0.25/0.125
  {0.75em}  % Run-in separation from following text

% ==============================================================================
% ALTERNATIVE PARAGRAPH STYLES
% ==============================================================================

% Alternative: Bold small caps paragraph with extensive tracking
% For users who prefer small caps but need strong contrast
\newcommand{\paragraphsc}{
  \titleformat{\paragraph}[runin]
    %% FIX(#39): drop dead \SetTracking{encoding=*}{120}; bold text resolves via
    %% the T1 series=b list (lnpmicrotype.sty:140 -> -10), which annuls the {120}
    %% (measured: orig == bare), so \lsstyle alone is render-neutral, no message.
    {\normalfont\fontsize{11}{13.2}\selectfont\bfseries\scshape\color{paragraphcolor}%
     \lsstyle}  % 11pt bold small caps
    %% FIX: same run-in zero-separation bug as the default \paragraph.
    {}
    {0em}
    {}
  \titlespacing*{\paragraph}
    {0pt}
    {1\gridunit plus 0.25\gridunit minus 0.125\gridunit}  % 1 unit ±0.25/0.125
    {0.75em}  % Run-in separation from following text
}

% Alternative: Display-style paragraph for maximum distinction
\newcommand{\displayparagraph}[1]{%
  \vspace{18pt}% Consistent with paragraph spacing
  {\normalfont\fontsize{11.5}{13.2}\color{paragraphgray}\scshape\bfseries #1}%
  \vspace{6pt}% Half baseline unit
  \par\noindent
}

% Safe paragraph command for Overleaf compatibility
% Use this if standard \paragraph causes "missing \item" errors
\newcommand{\safeparagraph}[1]{%
  \par\vspace{\gridunit}% 1 grid unit before
  {\normalfont\fontsize{11}{13.2}\selectfont\bfseries\itshape\color{paragraphcolor}#1}%
  \par\vspace{0.5\gridunit}% 0.5 grid units after
  \noindent
}

% ==============================================================================
% SECTION BREAK COMMANDS
% ==============================================================================

% Professional treatments for major section breaks in academic articles
\providecommand{\sectionopening}{}
\renewcommand{\sectionopening}[1]{%
  \par\vspace{2\gridunit}%
  \begin{center}
    {\fontsize{14pt}{19.8pt}\selectfont\itshape #1}%
  \end{center}
  \vspace{\gridunit}%
  \noindent
}

% Simple section break - clean space only
%% FIX: renamed \sectionbreak -> \sectionsep; titlesec executes any defined
%% \<level>break as a hook inside heading construction, so the old name
%% injected \vspace{2\gridunit} before every \section instead of \@secpenalty.
\providecommand{\sectionsep}{}
\renewcommand{\sectionsep}{%
  \par\vspace{2\gridunit}% 2 grid units of clean space
  \noindent
}

% Alias for compatibility
\providecommand{\spacebreak}{}
\renewcommand{\spacebreak}{\sectionsep}

% ==============================================================================
% WIDOW AND ORPHAN CONTROL FOR HEADINGS
% ==============================================================================

% Prevent isolated section headings
\@secpenalty=-1000           % Encourage breaks before sections
%% FIX: \clubpenalty/\widowpenalty restatements removed — the canonical
%% widow/orphan penalties (10000) live in lanepaper.sty. Note: standalone
%% use of this module gets LaTeX's defaults (150); load lnpcompilationfixes
%% for protection outside the full package.

% Note: Environment hooks moved to individual modules to avoid conflicts
% - List environment hooks are handled by lists.sty
% - Paragraph environment hooks are handled by paragraphs.sty
% This prevents "missing \item" errors when using \paragraph commands

% ==============================================================================
% LETTRINE SUPPORT
% ==============================================================================

% Drop cap configuration for section openings
\@ifpackageloaded{lettrine}{%
  \renewcommand{\LettrineFontHook}{\color{sectioncolor}}  % Match section color
  \setcounter{DefaultLines}{3}         % Three-line drop caps
  \renewcommand{\DefaultLoversize}{0}  % No descender adjustment
  \renewcommand{\DefaultLraise}{0}     % No baseline adjustment
  \setlength{\DefaultNindent}{0em}     % No additional indent
  \setlength{\DefaultSlope}{0em}       % No slope for italics
}{}

% First line treatment for section openings
\newcommand{\firstline}[1]{%
  {\scshape\MakeUppercase{#1}}%
}

% ==============================================================================
% DEFAULT SECTION SPACING
% ==============================================================================
% Set moderate spacing as the default for professional documents
\moderatesections

% ==============================================================================
% ROBUSTNESS (#55)
% ==============================================================================
% Every public macro defined above is made robust for moving arguments
% (section titles, captions, marks, the .aux round-trip) via etoolbox
% \robustify, which applies e-TeX \protected. Definitions stay \newcommand
% so a name collision with another package still errors at load time.
% \ifdefmacro skips names that resolve to registers in this load order.
\ifdefmacro{\spacioussections}{\robustify{\spacioussections}}{}
\ifdefmacro{\moderatesections}{\robustify{\moderatesections}}{}
\ifdefmacro{\compactsections}{\robustify{\compactsections}}{}
\ifdefmacro{\tightsections}{\robustify{\tightsections}}{}
\ifdefmacro{\paragraphsc}{\robustify{\paragraphsc}}{}
\ifdefmacro{\displayparagraph}{\robustify{\displayparagraph}}{}
\ifdefmacro{\safeparagraph}{\robustify{\safeparagraph}}{}
\ifdefmacro{\sectionopening}{\robustify{\sectionopening}}{}
\ifdefmacro{\sectionsep}{\robustify{\sectionsep}}{}
\ifdefmacro{\spacebreak}{\robustify{\spacebreak}}{}
\ifdefmacro{\firstline}{\robustify{\firstline}}{}
