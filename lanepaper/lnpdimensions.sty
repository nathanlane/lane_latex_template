% ==============================================================================
% LNPDIMENSIONS.STY - Page Layout, Spacing, and Paragraphs Module
% ==============================================================================
% Owns page geometry, paragraph fundamentals, and the 13.2pt spacing quantum
% every other module states its vertical spacing in. Internal to lanepaper
% (ADR-0006).
% ==============================================================================

\ProvidesPackage{lnpdimensions}[2026/08/12 v1.1 Page Layout, Spacing, and Paragraphs]

\RequirePackage{geometry}

% PAGE GEOMETRY
% Butterick's reading optimisation: a six-inch measure sets ~65 characters
% per line, the middle of the 45-90 band, at this size in Pagella.
%% FIX (#85): the measure is the invariant, not the sheet. This block used to
%% open with `letterpaper`, which overrode the class and silently printed
%% \documentclass[a4paper]{article} on Letter. Stating `textwidth` and
%% `hcentering` instead leaves \paperwidth to the class and reproduces the
%% established Letter page exactly: (8.5in - 6in)/2 = the 1.25in side margins.
\geometry{
  textwidth=6in,               % Butterick's optimal measure, ~65 characters
  hcentering,                  % Equal side margins on whatever sheet is set
  vmargin=1.25in,              % Established head and foot margins
  marginparwidth=1in
}

% SPACING QUANTUM FOUNDATION
% All vertical spacing derives from this fundamental unit.
%% FIX (#85, ADR-0006): the quantum is an implementation value, not a public
%% grid system. It was \gridunit, with six derived public lengths and two
%% expandable helpers on top; documents now write the space they mean.
\newlength{\lnp@gridunit}
%% FIX: \lnp@gridunit is a *spacing quantum*, not the document baseline.
%% \linespread{1.20} scales the class's baseline (size11.clo sets 10.95pt on
%% 13.6pt), so the real body baseline is 13.6 × 1.2 = 16.32pt — verified by
%% measurement, not 13.2pt as long claimed. See
%% docs/adr/0004-baseline-grid-is-a-spacing-quantum.md.
\setlength{\lnp@gridunit}{13.2pt}  % Spacing quantum (11pt × 1.20 nominal)

% CORE SPACING VALUES
\linespread{1.20}              % Scales the class baseline: 13.6pt × 1.20 = 16.32pt actual leading
\setlength{\parskip}{0pt}      % Zero paragraph spacing for grid alignment
%% FIX: \parindent is a horizontal indent and must not follow the vertical
%% spacing quantum; 13.2pt (~1.2em) is the one deliberate literal (ADR-0005).
\setlength{\parindent}{13.2pt} % Standard indent (~1.2em); deliberate literal

%% FIX (#87): Paragraph-mode APIs and their robustness hooks were removed in v3.
%% FIX (#87): First paragraphs after headings stay flush left through the
%% starred \titlespacing* declarations in lnpheadings.sty, in both its
%% unconditional and conditional branches. The old
%% \let\@afterindentfalse\@afterindenttrue was the indentfirst idiom: it
%% inverted every later \@afterindentfalse call and indented these paragraphs
%% by \parindent, while the comments around it claimed flush left. Do not
%% re-add that override here.

% ==============================================================================
% PROFESSIONAL BLOCK QUOTATION SYSTEM
% ==============================================================================
%
% Implements sophisticated block quotation typography following master principles:
% - Butterick: Visual distinction without jarring contrast
% - Hochuli: Subtle differentiation through spacing and margins
% - Brown: Systematic relationships with modular scale
%
% DESIGN DECISIONS:
%   - Size: 10.5pt (95% of body) for subtle subordination
%% FIX: \fontsize{10.5}{13.2} under \linespread{1.20} gives a real 15.84pt
%   - Leading: 15.84pt measured (13.2pt × \linespread)
%   - Margins: 26.4pt (2 quanta) optimized for Pagella's width
%   - Color: 15% gray matching paragraph heading hierarchy
%   - Spacing: 1 quantum before/after with asymmetric flexibility
%
% ------------------------------------------------------------------------------

%% FIX (#85): \lnp@quotegray moved to lnpcolors, the palette's owner.

% STANDARD BLOCK QUOTE
% For quotations without paragraph breaks
%% FIX: Use \list with \endlist so quote environments close correctly.
\renewenvironment{quote}{%
  \vspace{\lnp@gridunit}%     % 1 quantum before
  \list{}{%
    \setlength{\leftmargin}{2\lnp@gridunit}%       % 2 quanta (Pagella proportion)
    \setlength{\rightmargin}{2\lnp@gridunit}%      % Symmetric margins
    \setlength{\topsep}{0pt}%              % Spacing handled explicitly
    \setlength{\partopsep}{0pt}%
    \setlength{\parsep}{0.5\lnp@gridunit}%            % 0.5 units between paragraphs
    \setlength{\itemsep}{0pt}%
    \setlength{\listparindent}{\parindent}%
    \fontsize{10.5}{13.2}\selectfont%      % 95% size, same leading
    \color{lnp@quotegray}%                     % 15% gray for subtle distinction
  }%
  \item\relax
}{%
  \endlist
  \vspace{\lnp@gridunit}%     % 1 quantum after
  \@afterindentfalse%                       % No indent after quote
}

% EXTENDED QUOTATION
% For quotations with multiple paragraphs
\renewenvironment{quotation}{%
  \vspace{\lnp@gridunit}%
  \list{}{%
    \setlength{\leftmargin}{2\lnp@gridunit}%
    \setlength{\rightmargin}{2\lnp@gridunit}%
    \setlength{\topsep}{0pt}%
    \setlength{\partopsep}{0pt}%
    \setlength{\parsep}{0.5\lnp@gridunit}%
    \setlength{\itemsep}{0pt}%
    \setlength{\listparindent}{\lnp@gridunit}%    % Maintain paragraph indent
    \fontsize{10.5}{13.2}\selectfont%
    \color{lnp@quotegray}%
  }%
  \item\relax
}{%
  \endlist
  \vspace{\lnp@gridunit}%
  \@afterindentfalse%
}
