% ==============================================================================
% LNPPARAGRAPHS.STY - Paragraph Typography Module
% ==============================================================================
% Comprehensive paragraph handling including indentation, quotations,
% and special paragraph treatments following classical typography principles
% ==============================================================================

\ProvidesPackage{lnpparagraphs}[2026/08/12 v1.1 Paragraph Typography]

% Dependencies
\RequirePackage{lettrine}  % For drop caps
\RequirePackage{etoolbox}  % For environment hooks

% Ensure dimensions are loaded for the spacing quantum
\@ifpackageloaded{lnpdimensions}{}{%
  \RequirePackage{lnpdimensions}%
}

% Ensure colors are loaded
\@ifpackageloaded{lnpcolors}{}{%
  \RequirePackage{lnpcolors}%
}

% ==============================================================================
% CLASSICAL PARAGRAPH INDENTATION SYSTEM
% ==============================================================================
% Implements Bringhurst and Hochuli's principles for first paragraph handling
% First paragraphs after headings, lists, and breaks remain flush left

% Classical typography: first paragraphs after headings are flush left
\let\@afterindentfalse\@afterindenttrue
\@afterindentfalse  % Flush left first paragraphs after headings

% Custom commands for controlling indentation
%% FIX: Use providecommand so preload order with \texttt{lanepaper} stays
%% compatible when the package redefines these commands.
\providecommand{\noindentpar}{\noindent\ignorespaces}     % Explicit flush left
\providecommand{\forceindent}{\hspace{\parindent}}        % Force indentation

% Centered paragraph
%% FIX: Use providecommand so documented preloading into lanepaper does not
%% fail on duplicate helper definitions.
\providecommand{\centeredpar}[1]{%
  {\centering\noindent#1\par}%
}

% Dialogue support
\newcommand{\dialogue}[1]{\par\indent #1\par}

% ==============================================================================
% EPIGRAPH ENVIRONMENT
% ==============================================================================
% For quotations at chapter/section beginnings

\newenvironment{epigraph}{%
  \vspace{\lnp@gridunit}%                       % 1 quantum before
  \begin{flushright}%
  \begin{minipage}{0.618\textwidth}%        % Golden ratio width
  \raggedleft\itshape%
  \setlength{\parindent}{0pt}%
  \setlength{\parskip}{0.5\lnp@gridunit}%      % 0.5 quanta between paragraphs
}{%
  \end{minipage}%
  \end{flushright}%
  \vspace{\lnp@gridunit}%                       % 1 quantum after
  \@afterindentfalse%                       % No indent after epigraph
}

% ==============================================================================
% PROFESSIONAL BLOCK QUOTATION SYSTEM
% ==============================================================================
% Implements sophisticated block quotation typography following:
% - Butterick: Visual distinction without jarring contrast
% - Hochuli: Subtle differentiation through spacing and margins
% - Brown: Systematic relationships with modular scale

% Define quote gray color
\definecolor{lnp@quotegray}{gray}{0.15}  % 15% gray matches paragraph headings

% STANDARD BLOCK QUOTE
%% FIX: Use \list with \endlist so quote environments close correctly.
\renewenvironment{quote}{%
  \vspace{\lnp@gridunit}%                       % 1 quantum before
  \list{}{%
    \setlength{\leftmargin}{2\lnp@gridunit}%   % 2 quanta
    \setlength{\rightmargin}{2\lnp@gridunit}%  % Symmetric margins
    \setlength{\topsep}{0pt}%
    \setlength{\partopsep}{0pt}%
    \setlength{\parsep}{0.5\lnp@gridunit}%     % 0.5 units between paragraphs
    \setlength{\itemsep}{0pt}%
    \setlength{\listparindent}{\parindent}%
    \fontsize{10.5}{13.2}\selectfont%      % 95% size, same leading
    \color{lnp@quotegray}%                     % 15% gray
  }%
  \item\relax
}{%
  \endlist
  \vspace{\lnp@gridunit}%                      % 1 quantum after
  \@afterindentfalse%                      % No indent after quote
}

% EXTENDED QUOTATION
\renewenvironment{quotation}{%
  \vspace{\lnp@gridunit}%
  \list{}{%
    \setlength{\leftmargin}{2\lnp@gridunit}%
    \setlength{\rightmargin}{2\lnp@gridunit}%
    \setlength{\topsep}{0pt}%
    \setlength{\partopsep}{0pt}%
    \setlength{\parsep}{0.5\lnp@gridunit}%
    \setlength{\itemsep}{0pt}%
    \setlength{\listparindent}{\lnp@gridunit}% % Maintain paragraph indent
    \fontsize{10.5}{13.2}\selectfont%
    \color{lnp@quotegray}%
  }%
  \item\relax
}{%
  \endlist
  \vspace{\lnp@gridunit}%
  \@afterindentfalse%
}

% PROFESSIONAL ATTRIBUTION
\newcommand{\quoteattribution}[1]{%
  \par\vspace{0.5\lnp@gridunit}%               % 0.5 quanta
  \hfill{\fontsize{10}{13.2}\selectfont\color{lnp@subsubcolor}--- #1}%
  \par
}

% EMPHASIS QUOTE
\newenvironment{emphasisquote}{%
  \vspace{1.5\lnp@gridunit}%                   % 1.5 units before
  \list{}{%
    \setlength{\leftmargin}{3\lnp@gridunit}%  % 3 quanta
    \setlength{\rightmargin}{3\lnp@gridunit}% % Dramatic inset
    \setlength{\topsep}{0pt}%
    \setlength{\partopsep}{0pt}%
    \setlength{\parsep}{0.5\lnp@gridunit}%
    \setlength{\itemsep}{0pt}%
    \fontsize{12}{15.84}\selectfont%       % Larger for emphasis
    \itshape\color{lnp@quotegray}%             % Italic
  }%
  \item\relax
}{%
  \endlist
  \vspace{1.5\lnp@gridunit}%                   % 1.5 units after
  \@afterindentfalse%
}

% ==============================================================================
% ENVIRONMENT INDENTATION CONTROL
% ==============================================================================

% Note: List environment hooks (itemize, enumerate, description) are handled by lists.sty
% to avoid conflicts that can cause "missing \item" errors with \paragraph commands
\AtBeginEnvironment{quote}{\parindent=0pt}
\AtBeginEnvironment{quotation}{\parindent=\parindent}  % Quotation keeps indent
\AtBeginEnvironment{emphasisquote}{\parindent=0pt}
\AtBeginEnvironment{verbatim}{\parindent=0pt}
\AtBeginEnvironment{figure}{\parindent=0pt}
\AtBeginEnvironment{table}{\parindent=0pt}

% First paragraph after environments is flush left
% Note: List environment end hooks (itemize, enumerate, description) are handled by lists.sty
\AtEndEnvironment{quote}{\@afterindentfalse}
\AtEndEnvironment{emphasisquote}{\@afterindentfalse}
\AtEndEnvironment{verbatim}{\@afterindentfalse}
\AtEndEnvironment{figure}{\@afterindentfalse}
\AtEndEnvironment{table}{\@afterindentfalse}
\AtEndEnvironment{quotation}{\@afterindentfalse}
\AtEndEnvironment{epigraph}{\@afterindentfalse}

% ==============================================================================
% SECTION OPENING ENHANCEMENTS
% ==============================================================================

% Configure lettrine for drop caps
\@ifpackageloaded{lettrine}{%
  \renewcommand{\LettrineFontHook}{\color{lnp@sectioncolor}}
  \setcounter{DefaultLines}{3}
  \renewcommand{\DefaultLoversize}{0}
  \renewcommand{\DefaultLraise}{0}
  \setlength{\DefaultNindent}{0em}
  \setlength{\DefaultSlope}{0em}
}{}

% MINIMAL DROP CAP FOR ACADEMIC USE
\newcommand{\academicdropcap}[2]{%
  \lettrine[%
    lines=2,%               % Modest 2-line height
    lhang=0,%              % No hang into margin
    loversize=0,%          % No size increase
    findent=0pt,%          % No negative indent
    nindent=0.5em%         % Standard following line indent
  ]{\color{lnp@textblack}#1}{#2}%
}

% FIRST LINE SMALL CAPS
%% FIX: Use providecommand so preload order with lanepaper stays compatible.
%% FIX(#39): explicit \fontsize{11} matches no named-size sc list, so the {30}
%% WAS effective; \textls[30] preserves it (bare \lsstyle -> microtype fallback
%% 50). Mirrors the twin \firstlinesc definition in lanepaper.sty.
\providecommand{\firstlinesc}[1]{%
  {\fontsize{11}{13.2}\selectfont%
   \textls[30]{\textsc{#1}}}%
}

% SECTION OPENING WITH SMALL CAPS
\providecommand{\sectionopening}{}
\renewcommand{\sectionopening}[1]{%
  \noindent%
  \firstlinesc{#1}%
  \par\noindent%
}

%% FIX: renamed \sectionbreak -> \sectionsep; titlesec reserves \<level>break
%% as a hook it executes inside heading construction.
\providecommand{\sectionsep}{}
\renewcommand{\sectionsep}{%
  \vspace{2\lnp@gridunit}% 2 quanta of clean space
}

\providecommand{\spacebreak}{}
\renewcommand{\spacebreak}{\sectionsep}

% OPENING PARAGRAPH ENVIRONMENT
%% FIX: Avoid duplicate environment definitions when lanepaper was loaded
%% before this module.
\@ifundefined{openingparagraph}{%
\newenvironment{openingparagraph}{%
  \noindent%
  \setlength{\parindent}{0pt}%
}{%
  \par%
}
}{}

% ==============================================================================
% SPECIAL PARAGRAPH COMMANDS
% ==============================================================================

% Typography-aware ornamental paragraph break
%% FIX: renamed \paragraphbreak -> \paragraphsep and providecommand stays; the
%% old name collided with titlesec's \<level>break hook and made run-in
%% \paragraph fail with "perhaps a missing \item".
\providecommand{\paragraphsep}{%
  \par\vspace{\lnp@gridunit}% 1 quantum of vertical space
  \noindent%
}

% Inline sidenote command for margin annotations
%% FIX: Use providecommand so preload order with lanepaper stays compatible.
\providecommand{\sidenote}[1]{%
  \marginpar{%
    \footnotesize\raggedright%
    \setlength{\parindent}{0pt}%
    \setlength{\parskip}{0.25\lnp@gridunit}%
    #1%
  }%
}

% Legacy support commands
%% FIX: Use providecommand so this legacy helper remains preload-safe.
\providecommand{\compactpar}{\vspace{-0.25\lnp@gridunit}}
%% FIX: Use providecommand so preload order with lanepaper stays compatible.
\providecommand{\loosepars}{\vspace{0.25\lnp@gridunit}}
%% FIX: Use providecommand so preload order with lanepaper stays compatible.
\providecommand{\majorsectionspace}{\vspace{\lnp@gridunit}}


% ==============================================================================
% ROBUSTNESS (#55)
% ==============================================================================
% Every public macro defined above is made robust for moving arguments
% (section titles, captions, marks, the .aux round-trip) via etoolbox
% \robustify, which applies e-TeX \protected. Definitions stay \newcommand
% so a name collision with another package still errors at load time.
% \ifdefmacro skips names that resolve to registers in this load order.
\ifdefmacro{\noindentpar}{\robustify{\noindentpar}}{}
\ifdefmacro{\forceindent}{\robustify{\forceindent}}{}
\ifdefmacro{\centeredpar}{\robustify{\centeredpar}}{}
\ifdefmacro{\dialogue}{\robustify{\dialogue}}{}
\ifdefmacro{\quoteattribution}{\robustify{\quoteattribution}}{}
\ifdefmacro{\academicdropcap}{\robustify{\academicdropcap}}{}
\ifdefmacro{\firstlinesc}{\robustify{\firstlinesc}}{}
\ifdefmacro{\sectionopening}{\robustify{\sectionopening}}{}
\ifdefmacro{\sectionsep}{\robustify{\sectionsep}}{}
\ifdefmacro{\spacebreak}{\robustify{\spacebreak}}{}
\ifdefmacro{\paragraphsep}{\robustify{\paragraphsep}}{}
\ifdefmacro{\sidenote}{\robustify{\sidenote}}{}
\ifdefmacro{\compactpar}{\robustify{\compactpar}}{}
\ifdefmacro{\loosepars}{\robustify{\loosepars}}{}
\ifdefmacro{\majorsectionspace}{\robustify{\majorsectionspace}}{}

\endinput
