% ==============================================================================
% LNPCOLORS.STY - Semantic Colour Palette
% ==============================================================================
% Internal to lanepaper (ADR-0006). Every colour is \lnp@-prefixed: xcolor
% names live in one flat global namespace, and bare names like `textblack` or
% `linknavy` are exactly the ones a document or another package will collide
% with. Documents restyle their own text; they do not reach in here.
% ==============================================================================

\ProvidesPackage{lnpcolors}[2026/08/12 v1.1 Professional Color System]

\RequirePackage{xcolor}

% PRIMARY HIERARCHY COLOURS
% A restrained palette: near-black body text, a softened navy for the top two
% heading levels, and a grey ladder for everything subordinate.
\definecolor{lnp@textblack}{gray}{0.05}          % Near-black body text
\definecolor{lnp@sectioncolor}{RGB}{25,50,80}    % Softened navy, top level
\definecolor{lnp@subsectioncolor}{RGB}{40,40,55} % Muted midnight, second level
\definecolor{lnp@subsubcolor}{gray}{0.25}        % Medium charcoal
\definecolor{lnp@paragraphcolor}{gray}{0.15}     % Dark grey; bold at small sizes
\definecolor{lnp@subtlegray}{gray}{0.45}         % Captions, footnote rules, bullets
\definecolor{lnp@quotegray}{gray}{0.15}          % Block quotations
\definecolor{lnp@linknavy}{RGB}{0,68,136}        % Link theme colour for Pagella

%% FIX (#85): [nocolor] used to \definecolor every name as gray 0, which did
%% not just remove chroma -- it flattened the hierarchy, so section,
%% subsection, subsubsection and body all printed identical black. Converting
%% the same palette through xcolor's gray model removes chroma and nothing
%% else: the grey steps above are already grey, so they pass through
%% untouched, and the two navies land on distinct dark greys.
\iflnp@nocolor
  \colorlet{lnp@textblack}[gray]{lnp@textblack}
  \colorlet{lnp@sectioncolor}[gray]{lnp@sectioncolor}
  \colorlet{lnp@subsectioncolor}[gray]{lnp@subsectioncolor}
  \colorlet{lnp@subsubcolor}[gray]{lnp@subsubcolor}
  \colorlet{lnp@paragraphcolor}[gray]{lnp@paragraphcolor}
  \colorlet{lnp@subtlegray}[gray]{lnp@subtlegray}
  \colorlet{lnp@quotegray}[gray]{lnp@quotegray}
  \colorlet{lnp@linknavy}[gray]{lnp@linknavy}
\fi

\endinput
